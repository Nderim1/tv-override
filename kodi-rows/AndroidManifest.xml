<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nde.kodirows">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Kodi's JSON-RPC on 127.0.0.1:9090 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Home screen rows (TvProvider preview channels); granted by tvctl over ADB -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <!-- Keeps the hourly refresh job across reboots; renews poster access at boot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Keeps signed live streams renewing while Kodi is in front. No owner permission prompt. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <queries>
        <package android:name="org.xbmc.kodi" />
        <!-- home screen apps get read access to the posters -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application android:label="@string/app_name" android:icon="@drawable/logo" android:allowBackup="false">
        <!-- Opened by a poster on the home screen: brings Kodi up and plays that movie. -->
        <activity
            android:name=".PlayActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".RefreshJob"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service android:name=".LiveService" android:exported="false" android:foregroundServiceType="mediaPlayback" />

        <!-- Cached posters for the launcher (it won't download remote program art itself). Read-only. -->
        <provider
            android:name=".PosterProvider"
            android:authorities="com.nde.kodirows.posters"
            android:exported="true"
            android:grantUriPermissions="true" />

        <!-- Shows and slowly scrolls the whole plot of the focused movie on the home screen (owner turns it on). -->
        <service
            android:name=".DescriptionService"
            android:label="@string/a11y_label"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- Renews the poster grants after a reboot. -->
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Rows from tvctl. DUMP is held by the ADB shell, not by normal apps. -->
        <receiver
            android:name=".ConfigReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.nde.kodirows.SET_CONFIG" />
                <action android:name="com.nde.kodirows.GET_CONFIG" />
                <action android:name="com.nde.kodirows.GET_STATUS" />
                <action android:name="com.nde.kodirows.REFRESH" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
