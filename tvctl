ROOT = Path(__file__).resolve().parent
PRESETS_DIR = ROOT / "presets"
PROFILES_DIR = ROOT / "profiles"
STATE_DIR = ROOT / "state"
UI_PORT = int(os.environ.get("TVCTL_UI_PORT", "8787"))
UI_TOKEN_FILE = STATE_DIR / ".ui-token"
CATALOG_FILE = ROOT / "apps.toml"

EXIT_OK, EXIT_ERR, EXIT_USER = 0, 1, 2
CLASS_PRIORITY = {"core": 0, "bloat": 1, "optional": 2}
REMAP_RECEIVER = "com.nde.tvremap/.ConfigReceiver"
ANIMATION_KEYS = ("window_animation_scale", "transition_animation_scale", "animator_duration_scale")


class TvError(Exception):
    pass


# ---------------------------------------------------------------- adb / device

def find_adb():
    for cand in (shutil.which("adb"),
                 Path.home() / "Library/Android/sdk/platform-tools/adb",
                 Path.home() / "Android/Sdk/platform-tools/adb",
                 "/opt/homebrew/bin/adb", "/usr/local/bin/adb"):
        if cand and Path(cand).exists():
            return str(cand)
    raise TvError("adb not found – install Android platform-tools")


def run(args, timeout=60):
    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        raise TvError(f"timed out: {' '.join(args[:4])}…")
    return p.returncode, p.stdout.replace("\r", ""), p.stderr.replace("\r", "")


class Device:
    def __init__(self, host, port=5555):
        self.addr = f"{host}:{port}"
        self.adb_bin = find_adb()

    def adb(self, *args, timeout=60):
        return run([self.adb_bin, "-s", self.addr, *args], timeout=timeout)

    def sh(self, script, timeout=60):
        _, out, _ = self.adb("shell", script, timeout=timeout)
        return out.strip()

    def state(self):
        _, out, err = self.adb("get-state", timeout=10)
        text = (out + err).strip()
        if "unauthorized" in text:
            return "unauthorized"
        return "device" if text == "device" else "offline"

    def connect(self, wait=0):
        """Connect; with wait>0 keep retrying (e.g. while the owner accepts the ADB prompt)."""
        deadline = time.time() + wait
        told = False
        while True:
            run([self.adb_bin, "connect", self.addr], timeout=15)
            st = self.state()
            if st == "device":
                return
            if time.time() >= deadline:
                if st == "unauthorized":
                    raise TvError("TV refused ADB: accept 'Allow USB debugging?' on the TV "
                                  "(tick 'Always allow from this computer') and retry")
                raise TvError(f"cannot reach {self.addr}: check the IP, that the TV is on, "
                              "and that Developer options > USB debugging is on")
            if st == "unauthorized" and not told:
                print("→ Accept 'Allow USB debugging?' on the TV (tick 'Always allow')…", file=sys.stderr)
                told = True
            time.sleep(3)

    def prop(self, name):
        return self.sh(f"getprop {name}")

    def props(self):
        names = ["ro.product.manufacturer", "ro.product.model", "ro.product.device", "ro.product.name",
                 "ro.build.version.release", "ro.build.version.sdk", "ro.serialno", "ro.product.cpu.abi"]
        out = self.sh("; ".join(f'echo "{n}=$(getprop {n})"' for n in names))
        return dict(line.split("=", 1) for line in out.splitlines() if "=" in line)

    def packages(self):
        """{pkg: {"enabled": bool, "user": bool}} for every installed package."""
        out = self.sh("pm list packages; echo ---; pm list packages -d; echo ---; pm list packages -3")
        all_, disabled, user = (
            {l.split(":", 1)[1].strip() for l in part.splitlines() if l.startswith("package:")}
            for part in out.split("---"))
        return {p: {"enabled": p not in disabled, "user": p in user} for p in sorted(all_)}

    def setting(self, ns, key):
        v = self.sh(f"settings get {ns} {key}")
        return None if v == "null" else v

    def home(self):
        out = self.sh("cmd package resolve-activity --brief -a android.intent.action.MAIN "
                      "-c android.intent.category.HOME")
        return out.splitlines()[-1].strip() if out else ""

    def a11y_enabled(self):
        v = self.setting("secure", "enabled_accessibility_services") or ""
        return [s for s in v.split(":") if s]

    def running(self, pkg):
        return bool(self.sh(f"pidof {pkg}"))

    def version(self, pkg):
        m = re.search(r"versionName=(\S+)", self.sh(f"dumpsys package {pkg}"))
        return m.group(1) if m else None

    def mem_available_mb(self):
        m = re.search(r"MemAvailable:\s+(\d+)", self.sh("cat /proc/meminfo"))
        return int(m.group(1)) // 1024 if m else None

    def pss_by_process(self):
        out = self.sh("dumpsys meminfo", timeout=90)
        block = out.split("Total PSS by process:", 1)[-1].split("Total PSS by OOM", 1)[0]
        res = {}
        for m in re.finditer(r"([\d,]+)K: (\S+) \(pid", block):
            res[m.group(2)] = int(m.group(1).replace(",", "")) // 1024
        return res

    def reboot_and_wait(self, timeout=240):
        self.adb("reboot")
        time.sleep(10)
        deadline = time.time() + timeout
        while time.time() < deadline:
            run([self.adb_bin, "connect", self.addr], timeout=10)
            if self.state() == "device" and self.prop("sys.boot_completed") == "1":
                time.sleep(15)  # let the launcher and services settle
                return
            time.sleep(5)
        raise TvError(f"TV did not come back within {timeout // 60} minutes")

    def tv_settings(self):
        keys = [("secure", "screensaver_components"), ("secure", "screensaver_enabled")] + \
               [("global", k) for k in ANIMATION_KEYS]
        return {k: self.setting(ns, k) for ns, k in keys}

    def broadcast(self, component, action, extras=""):
        out = self.sh(f"am broadcast -f 32 -n {component} -a {action} {extras}")
        m = re.search(r'result=(-?\d+)(?:, data="(.*)")?', out, re.S)
        if not m:
            raise TvError(f"broadcast failed: {out[-200:]}")
        return int(m.group(1)), (m.group(2) or "")


# ---------------------------------------------------------------- config

def load_toml(path):
    with open(path, "rb") as f:
        return tomllib.load(f)


def load_catalog():
    return load_toml(CATALOG_FILE)


def profile_path(arg):
    p = Path(arg)
    if p.suffix == ".toml" and p.exists():
        return p
    p = PROFILES_DIR / f"{arg}.toml"
    if not p.exists():
        raise TvError(f"no profile {p} (create one with: tvctl init {arg} --host IP)")
    return p


def load_profile(arg):
    path = profile_path(arg)
    prof = load_toml(path)
    prof["_path"] = path
    tv = prof.setdefault("tv", {})
    if "host" not in tv:
        raise TvError(f"{path}: [tv].host missing")
    tv.setdefault("name", path.stem)
    for section in ("apps", "home", "keys"):
        prof.setdefault(section, {})
    return prof


def all_presets():
    return {p.stem: load_toml(p) for p in sorted(PRESETS_DIR.glob("*.toml")) if not p.name.startswith("_")}


def active_presets(names):
    presets = all_presets()
    missing = [n for n in names if n not in presets]
    if missing:
        raise TvError(f"unknown preset(s): {', '.join(missing)}")
    return [p for n, p in presets.items() if n in names or p.get("preset", {}).get("always")]


def detect_presets(props, pkgs):
    found = []
    for name, p in all_presets().items():
        if p.get("preset", {}).get("always"):
            continue
        match = p.get("match", {})
        manu = [m.lower() for m in match.get("manufacturer", [])]
        if manu and props.get("ro.product.manufacturer", "").lower() in manu:
            found.append(name)
        elif any(pkg in pkgs for pkg in match.get("packages_any", [])):
            found.append(name)
    return found


class Classifier:
    def __init__(self, presets):
        self.exact, self.globs = {}, []
        for p in presets:
            pname = p.get("preset", {}).get("name", "?")
            for cls in CLASS_PRIORITY:
                for pattern, note in p.get(cls, {}).items():
                    entry = (cls, note, pname)
                    if any(c in pattern for c in "*?["):
                        self.globs.append((pattern, entry))
                    elif pattern not in self.exact or CLASS_PRIORITY[cls] < CLASS_PRIORITY[self.exact[pattern][0]]:
                        self.exact[pattern] = entry

    def classify(self, pkg):
        if pkg in self.exact:
            return self.exact[pkg]
        hits = [e for pat, e in self.globs if fnmatch.fnmatchcase(pkg, pat)]
        return min(hits, key=lambda e: CLASS_PRIORITY[e[0]]) if hits else ("unknown", "", None)


def merged(presets, section):
    out = {}
    for p in presets:
        out.update(p.get(section, {}))
    return out


def stock_launcher(presets):
    stock, home = [], None
    for p in presets:
        launcher = p.get("launcher", {})
        stock += [s for s in launcher.get("stock", []) if s not in stock]
        home = home or launcher.get("stock_home")
    return stock, home


def live_tv(presets):
    """(protected packages, player package) from the presets' [live_tv] sections."""
    pkgs, player = set(), None
    for p in presets:
        section = p.get("live_tv", {})
        pkgs |= set(section.get("packages", []))
        player = player or section.get("player")
    return pkgs, player


def live_tv_status(dev, presets, pkgs):
    inputs = sorted(set(re.findall(r"TvInputInfo\{id=([^,]+),", dev.sh("dumpsys tv_input"))))
    tuners = [i for i in inputs if not re.search(r"passthrough|hdmi", i, re.I)]
    rows = dev.sh("content query --uri content://android.media.tv/channel --projection _id")
    protected, player = live_tv(presets)
    return {"tuner_inputs": tuners, "external_inputs": len(inputs) - len(tuners),
            "channels": sum(1 for l in rows.splitlines() if l.startswith("Row:")),
            "player": player, "player_enabled": bool(player and pkgs.get(player, {}).get("enabled")),
            "protected_disabled": sorted(p for p in protected if p in pkgs and not pkgs[p]["enabled"])}


# ---------------------------------------------------------------- state

def state_dir(prof):
    d = STATE_DIR / prof["tv"]["name"]
    d.mkdir(parents=True, exist_ok=True)
    return d


def now_iso():
    return datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds")


def take_snapshot(dev, prof, filename=None):
    snap = {"taken": now_iso(), "props": dev.props(), "settings": dev.tv_settings(), "packages": dev.packages()}
    name = filename or f"snapshot-{datetime.now():%Y%m%d-%H%M%S}.json"
    path = state_dir(prof) / name
    path.write_text(json.dumps(snap, indent=1))
    return path


def log_history(prof, actions):
    with open(state_dir(prof) / "history.jsonl", "a") as f:
        for a in actions:
            if a["status"] in ("done", "error"):
                f.write(json.dumps({"time": now_iso(), **{k: v for k, v in a.items() if k != "fn"}}) + "\n")


def perf(dev, pkgs=None):
    """Performance snapshot: memory, swap, load, storage, top processes, package counts."""
    out = dev.sh("cat /proc/meminfo; echo ---; cat /proc/loadavg; echo ---; cat /proc/uptime; echo ---; df -k /data")
    mem_part, load_part, up_part, df_part = (out.split("---") + ["", "", "", ""])[:4]
    mem = {m.group(1): int(m.group(2)) // 1024 for m in re.finditer(r"^(\w+):\s+(\d+) kB", mem_part, re.M)}
    load = load_part.split()
    df = df_part.strip().splitlines()[-1].split() if df_part.strip() else []
    pss = dev.pss_by_process()
    pkgs = pkgs if pkgs is not None else dev.packages()
    return {
        "time": now_iso(),
        "mem_total_mb": mem.get("MemTotal"), "mem_available_mb": mem.get("MemAvailable"),
        "swap_total_mb": mem.get("SwapTotal"),
        "swap_used_mb": (mem.get("SwapTotal", 0) - mem.get("SwapFree", 0)) if "SwapTotal" in mem else None,
        "load1": float(load[0]) if load else None, "load5": float(load[1]) if len(load) > 1 else None,
        "uptime_s": int(float(up_part.split()[0])) if up_part.split() else None,
        "storage_total_gb": round(int(df[1]) / 1048576, 1) if len(df) > 3 else None,
        "storage_free_gb": round(int(df[3]) / 1048576, 1) if len(df) > 3 else None,
        "processes": len(pss),
        "top": [{"name": n, "mb": mb} for n, mb in sorted(pss.items(), key=lambda kv: -kv[1])[:12]],
        "packages": {"total": len(pkgs), "enabled": sum(1 for i in pkgs.values() if i["enabled"]),
                     "disabled": sum(1 for i in pkgs.values() if not i["enabled"]),
                     "user": sum(1 for i in pkgs.values() if i["user"])},
    }


def runs_dir(name):
    d = STATE_DIR / name / "runs"
    d.mkdir(parents=True, exist_ok=True)
    return d


def save_run(record):
    clean = {**record, "rounds": [[{k: v for k, v in a.items() if k != "fn"} for a in r] for r in record["rounds"]]}
    path = runs_dir(record["tv"]) / f"{record['id']}.json"
    path.write_text(json.dumps(clean, indent=1))
    return path


def list_runs(name):
    d = STATE_DIR / name / "runs"
    if not d.exists():
        return []
    return [json.loads(p.read_text()) for p in sorted(d.glob("*.json"), reverse=True)]


# ---------------------------------------------------------------- planning

def action(step, target, what, detail="", status="todo", fn=None, undo=None):
    """One planned change. `undo` records how to reverse it exactly (used by `tvctl revert`)."""
    return {"step": step, "target": target, "action": what, "detail": detail, "status": status, "fn": fn,
            "undo": undo}


class Ctx:
    def __init__(self, prof, dev):
        self.prof, self.dev = prof, dev
        self.catalog = load_catalog()
        self.presets = active_presets(prof["tv"].get("presets", []))
        self.classifier = Classifier(self.presets)
        self.quirks = merged(self.presets, "quirks")
        self.opened = set()
        self.refresh()

    def refresh(self):
        self.pkgs = self.dev.packages()

    def open_play_page(self, pkg):
        if pkg not in self.opened:  # once per run, not on every re-check
            self.opened.add(pkg)
            self.dev.sh(f"am start -a android.intent.action.VIEW -d market://details?id={pkg}")

    def app(self, app_id):
        if app_id not in self.catalog:
            raise TvError(f"'{app_id}' is not in apps.toml")
        return self.catalog[app_id]

    def installed(self, pkg):
        return pkg in self.pkgs

    def enabled(self, pkg):
        return self.pkgs.get(pkg, {}).get("enabled", False)

    def install_ids(self):
        return list(self.prof["apps"].get("install", []))

    def resolve_pkg(self, ref):
        """Catalog id or package name -> package name."""
        return self.catalog[ref]["package"] if ref in self.catalog else ref


def check_identity(ctx):
    want = ctx.prof["tv"].get("serial")
    got = ctx.dev.prop("ro.serialno")
    if want and got and want != got:
        raise TvError(f"this is not {ctx.prof['tv']['name']}: serial {got} != profile {want}")


def plan_baseline(ctx):
    if (state_dir(ctx.prof) / "baseline.json").exists():
        return []
    return [action("baseline", "packages", "snapshot", "first run: save the untouched package state",
                   fn=lambda: take_snapshot(ctx.dev, ctx.prof, "baseline.json"))]


def install_apk_fn(ctx, app, force=False):
    def fn():
        path = ROOT / app["file"]
        if not path.exists():
            if app.get("build"):
                raise TvError(f"{path} missing – build it: bash {app['build']}")
            raise TvError(f"{path} missing")
        if app.get("sha256"):
            digest = hashlib.sha256(path.read_bytes()).hexdigest()
            if digest != app["sha256"]:
                raise TvError(f"sha256 mismatch for {path.name}: {digest}")
        code, out, err = ctx.dev.adb("install", "-r", str(path), timeout=300)
        if "Success" not in out:
            raise TvError((out + err).strip()[-300:])
    return fn


def plan_install(ctx):
    acts = []
    for app_id in ctx.install_ids():
        app = ctx.app(app_id)
        pkg = app["package"]
        if ctx.installed(pkg):
            if not ctx.enabled(pkg):
                acts.append(action("install", pkg, "enable", app["name"],
                                   fn=lambda p=pkg: pm(ctx, "enable", p), undo={"op": "disable", "pkg": pkg}))
            continue
        if app["source"] == "apk":
            acts.append(action("install", pkg, "install", f"{app['name']} from {app['file']}",
                               fn=install_apk_fn(ctx, app), undo={"op": "uninstall", "pkg": pkg}))
        elif app["source"] == "play" and not ctx.installed("com.android.vending"):
            acts.append(action("install", pkg, "install", f"no Play Store on this device: add a verified APK for "
                               f"{app['name']} to apps.toml (prompts/verify-apk.md)", status="blocked"))
        elif app["source"] == "play":
            acts.append(action("install", pkg, "install", f"Install {app['name']} on the Play Store page "
                               "now open on the TV, then re-run apply", status="manual",
                               fn=lambda p=pkg: ctx.open_play_page(p)))
        else:
            acts.append(action("install", pkg, "missing", f"{app['name']} is not on this TV", status="skipped"))
    return acts


def plan_autostart(ctx):
    op = ctx.quirks.get("autostart_appop")
    if not op:
        return []
    acts = []
    for app_id in ctx.install_ids():
        app = ctx.app(app_id)
        pkg = app["package"]
        if app.get("autostart") and ctx.installed(pkg):
            current = ctx.dev.sh(f"appops get {pkg} {op}")
            if "allow" not in current:
                prev = re.search(rf"{op}: (\w+)", current)
                acts.append(action("autostart", pkg, "allow", f"vendor autostart app-op {op}",
                                   fn=lambda p=pkg: ctx.dev.sh(f"appops set {p} {op} allow"),
                                   undo={"op": "appop", "pkg": pkg, "name": op,
                                         "value": prev.group(1) if prev else "default"}))
    return acts


def plan_a11y(ctx):
    acts = []
    enabled = ctx.dev.a11y_enabled()
    for app_id in ctx.install_ids():
        app = ctx.app(app_id)
        pkg, comp = app["package"], app.get("a11y")
        if not comp or not ctx.installed(pkg):
            continue
        label = app.get("a11y_label", app["name"])
        if comp not in enabled:
            acts.append(action("a11y", pkg, "enable-service",
                               f"On the TV: Settings → System → Accessibility → {label} → On", status="manual"))
        elif not ctx.dev.running(pkg):
            acts.append(action("a11y", pkg, "rebind-service",
                               f"On the TV: Settings → System → Accessibility → {label} → Off, then On",
                               status="manual"))
    return acts


def keymap_string(ctx):
    parts = []
    for scan, k in sorted(ctx.prof["keys"].items(), key=lambda kv: int(kv[0])):
        if "action" in k:
            parts.append(f"{int(scan)}=action:{ctx.resolve_pkg(k['package'])}/{k['action']}")
        else:
            parts.append(f"{int(scan)}=app:{ctx.resolve_pkg(k['open'])}")
    return ";".join(parts)


def keymap_app(ctx):
    for app_id in ctx.install_ids():
        app = ctx.app(app_id)
        if app.get("keymap"):
            return app
    return None


def push_keymap(ctx, raw):
    code, data = ctx.dev.broadcast(REMAP_RECEIVER, "com.nde.tvremap.SET_KEYMAP", f"--es keymap {shlex.quote(raw)}")
    if code != 1:
        raise TvError(f"Remote Remap rejected the key map: {data}")


def plan_keymap(ctx):
    app = keymap_app(ctx)
    if not app or not ctx.prof["keys"]:
        return []
    if not ctx.installed(app["package"]):
        return [action("keys", app["package"], "push", "waiting for Remote Remap to be installed", status="blocked")]
    raw = keymap_string(ctx)
    _, current = ctx.dev.broadcast(REMAP_RECEIVER, "com.nde.tvremap.GET_KEYMAP")
    if current == raw:
        return []
    return [action("keys", app["package"], "push", raw, fn=lambda: push_keymap(ctx, raw),
                   undo={"op": "keymap", "value": current})]


def pm(ctx, verb, pkg):
    cmd = {"disable": f"pm disable-user --user 0 {pkg}", "enable": f"pm enable --user 0 {pkg}"}[verb]
    out = ctx.dev.sh(cmd)
    if "new state" not in out:
        raise TvError(out[-200:] or f"{verb} failed")


def plan_packages(ctx):
    apps = ctx.prof["apps"]
    keep = set(apps.get("keep", []))
    wanted_off = set(apps.get("disable", []))
    protected = {ctx.app(i)["package"] for i in ctx.install_ids()}
    live, _ = live_tv(ctx.presets)
    acts = []
    for pkg in sorted(ctx.pkgs):
        if pkg in live:
            if not ctx.enabled(pkg):
                acts.append(action("live-tv", pkg, "enable", "live TV package must stay on",
                                   fn=lambda p=pkg: pm(ctx, "enable", p)))
            elif pkg in wanted_off:
                acts.append(action("packages", pkg, "disable", "refused: needed for live TV", status="error"))
            continue
        cls, note, _ = ctx.classifier.classify(pkg)
        on = ctx.enabled(pkg)
        if pkg in keep:
            if not on:
                acts.append(action("packages", pkg, "enable", "listed in keep", fn=lambda p=pkg: pm(ctx, "enable", p),
                                   undo={"op": "disable", "pkg": pkg}))
            continue
        if pkg in wanted_off:
            if cls == "core":
                acts.append(action("packages", pkg, "disable", f"refused: core package ({note})", status="error"))
            elif pkg in protected:
                acts.append(action("packages", pkg, "disable", "refused: in [apps].install", status="error"))
            elif on:
                acts.append(action("packages", pkg, "disable", note or "listed in disable",
                                   fn=lambda p=pkg: pm(ctx, "disable", p), undo={"op": "enable", "pkg": pkg}))
        elif cls == "bloat" and on and pkg not in protected:
            acts.append(action("packages", pkg, "disable", note, fn=lambda p=pkg: pm(ctx, "disable", p),
                               undo={"op": "enable", "pkg": pkg}))
    for pkg in sorted(wanted_off - set(ctx.pkgs)):
        acts.append(action("packages", pkg, "disable", "not installed on this TV", status="skipped"))
    return acts


def uninstall_fn(ctx, pkg):
    def fn():
        _, out, err = ctx.dev.adb("uninstall", pkg, timeout=120)
        if "Success" not in out:
            raise TvError((out + err).strip()[-200:])
    return fn


def plan_user_apps(ctx):
    apps = ctx.prof["apps"]
    acts = []
    wanted = {ctx.app(i)["package"] for i in ctx.install_ids()}
    replaced = {old for i in ctx.install_ids() for old in ctx.app(i).get("replaces", [])}
    for pkg in sorted(replaced & set(ctx.pkgs)):
        acts.append(action("user-apps", pkg, "uninstall", "replaced by a newer catalog app (owner signs in again)",
                           status="confirm", fn=uninstall_fn(ctx, pkg),
                           undo={"op": "reinstall", "pkg": pkg}))
    for pkg in sorted(set(apps.get("uninstall", [])) - replaced):
        if pkg in ctx.pkgs and pkg not in wanted:
            acts.append(action("user-apps", pkg, "uninstall", "listed in [apps].uninstall (deletes its data)",
                               status="confirm", fn=uninstall_fn(ctx, pkg),
                           undo={"op": "reinstall", "pkg": pkg}))
    if apps.get("user_apps", "keep-others") == "remove-others":
        keep = set(apps.get("keep", [])) | wanted | replaced | set(apps.get("uninstall", []))
        for pkg, info in ctx.pkgs.items():
            if info["user"] and pkg not in keep:
                acts.append(action("user-apps", pkg, "uninstall", "user app not in install/keep (deletes its data)",
                                   status="confirm", fn=uninstall_fn(ctx, pkg),
                           undo={"op": "reinstall", "pkg": pkg}))
    return acts


def plan_launcher(ctx):
    choice = ctx.prof["home"].get("launcher")
    if not choice:
        return []
    stock, stock_home = stock_launcher(ctx.presets)
    acts = []
    if choice == "stock":
        for pkg in stock:
            if ctx.installed(pkg) and not ctx.enabled(pkg):
                acts.append(action("home", pkg, "enable", "restore stock home", fn=lambda p=pkg: pm(ctx, "enable", p)))
        if stock_home and ctx.dev.home() != stock_home:
            acts.append(action("home", stock_home, "set-home", "stock home",
                               fn=lambda: ctx.dev.sh(f"cmd package set-home-activity --user 0 {stock_home}")))
        return acts
    app = ctx.app(choice)
    pkg, home = app["package"], app.get("home")
    if not home:
        raise TvError(f"apps.toml: {choice} has no `home` activity")
    missing = []
    if not ctx.installed(pkg):
        missing.append(f"{app['name']} installed")
    if app.get("a11y") and app["a11y"] not in ctx.dev.a11y_enabled():
        missing.append(f"its accessibility service on")
    if missing:
        return [action("home", pkg, "replace-stock", "waiting for: " + ", ".join(missing), status="blocked")]
    if ctx.dev.home() != home or any(ctx.enabled(p) for p in stock):
        def fn():
            for p in stock:  # stock home and setup wizard go together, see presets/google-tv.toml
                if ctx.enabled(p):
                    pm(ctx, "disable", p)
            ctx.dev.sh(f"cmd package set-home-activity --user 0 {home}")
            if ctx.dev.home() != home:
                raise TvError(f"home resolves to {ctx.dev.home()} instead of {home}")
        acts.append(action("home", pkg, "replace-stock", f"set {app['name']} as home, disable {', '.join(stock)}", fn=fn,
                           undo={"op": "launcher", "enable": [p for p in stock if ctx.enabled(p)],
                                 "home": ctx.dev.home()}))
    return acts


def plan_screensaver(ctx):
    choice = ctx.prof["home"].get("screensaver")
    if not choice:
        return []
    app = ctx.app(choice)
    comp = app.get("dream")
    if not comp:
        raise TvError(f"apps.toml: {choice} has no `dream` component")
    if not ctx.enabled(app["package"]):
        return [action("screensaver", comp, "set", f"waiting for {app['name']} to be installed/enabled", status="blocked")]
    if ctx.dev.setting("secure", "screensaver_components") == comp and ctx.dev.setting("secure", "screensaver_enabled") == "1":
        return []
    def fn():
        ctx.dev.sh(f"settings put secure screensaver_components {comp}; settings put secure screensaver_enabled 1")
    prev = {k: ctx.dev.setting("secure", k) for k in ("screensaver_components", "screensaver_enabled")}
    return [action("screensaver", comp, "set", app["name"], fn=fn,
                   undo={"op": "settings", "ns": "secure", "values": prev})]


def plan_animations(ctx):
    scale = ctx.prof["home"].get("animation_scale")
    if scale is None:
        return []
    want = f"{float(scale):g}"
    current = {k: ctx.dev.setting("global", k) for k in ANIMATION_KEYS}
    if all(v is not None and f"{float(v):g}" == want for v in current.values()):
        return []
    return [action("animations", "global", "set", f"{want}x",
                   fn=lambda: ctx.dev.sh("; ".join(f"settings put global {k} {want}" for k in ANIMATION_KEYS)),
                   undo={"op": "settings", "ns": "global", "values": current})]


PLANNERS = [plan_baseline, plan_install, plan_autostart, plan_a11y, plan_keymap,
            plan_packages, plan_user_apps, plan_launcher, plan_screensaver, plan_animations]


def make_plan(ctx):
    acts = []
    for planner in PLANNERS:
        acts += planner(ctx)
    return acts


# ---------------------------------------------------------------- output

def public(acts):
    return [{k: v for k, v in a.items() if k != "fn"} for a in acts]


def emit(args, data, human):
