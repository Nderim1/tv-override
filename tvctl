def helper_runtime(name=None):
    cfg = load_toml(ROOT / "agent.toml")
    choice = name or os.environ.get("TVCTL_AGENT_RUNTIME") or cfg.get("runtime", "auto")
    runtimes = cfg.get("runtimes", {})
    if choice == "auto":
        choice = next((r for r in cfg.get("order", list(runtimes)) if r in runtimes
                       and shutil.which(runtimes[r]["command"][0])), None)
        if not choice:
            raise TvError("no agent CLI found for helpers (install codex or claude, or set runtime in agent.toml)")
    if choice not in runtimes:
        raise TvError(f"unknown runtime {choice}; agent.toml has {', '.join(runtimes)}")
    return choice, runtimes[choice], cfg


def helper_command(rt, cfg, out, model=None):
    model = model or os.environ.get("TVCTL_AGENT_MODEL") or cfg.get("model") or ""
    args = []
    for part in rt["command"]:
        if part == "{model_args}":
            args += [a.replace("{model}", model) for a in rt.get("model_args", [])] if model else []
        else:
            args.append(part.replace("{effort}", rt.get("effort", "low")).replace("{out}", str(out)))
    return args


def cmd_helper(args):
    """Run one read-only helper role on the same model at the lowest effort and print its answer."""
    if args.list:
        name, rt, cfg = helper_runtime(args.runtime)
        roles = sorted(p.stem for p in ROLES_DIR.glob("*.md"))
        emit(args, {"runtime": name, "command": helper_command(rt, cfg, "<out>", args.model), "roles": roles},
             lambda: print(f"runtime: {name}\ncommand: {' '.join(helper_command(rt, cfg, '<out>', args.model))}\n"
                           f"roles: {', '.join(roles)}"))
        return EXIT_OK
    if not args.role or not args.question:
        raise TvError("usage: tvctl helper <role> --tv <tv> \"<question>\"")
    role_file = ROLES_DIR / f"{args.role}.md"
    if not role_file.exists():
        raise TvError(f"no role {args.role} (prompts/roles/)")
    name, rt, cfg = helper_runtime(args.runtime)
    prompt = (role_file.read_text() + f"\n\n---\nRepository root (run commands from here): {ROOT}\n"
              + (f"TV profile: {args.tv}\n" if args.tv else "")
              + f"Question from the main agent: {' '.join(args.question)}\n"
              "Answer with your report only. You are read-only: never change the TV or any file.\n")
    with tempfile.TemporaryDirectory() as tmp:
        out = Path(tmp) / "answer.txt"
        cmd = helper_command(rt, cfg, out, args.model)
        try:
            p = subprocess.run(cmd, input=prompt, capture_output=True, text=True, cwd=ROOT,
                               timeout=args.timeout or cfg.get("timeout", 600))
        except subprocess.TimeoutExpired:
            raise TvError(f"{args.role} helper timed out")
        answer = out.read_text().strip() if out.exists() else p.stdout.strip()
        if p.returncode != 0 and not answer:
            raise TvError(f"{name} helper failed ({p.returncode}): {(p.stderr or p.stdout).strip()[-400:]}")
    emit(args, {"role": args.role, "runtime": name, "answer": answer}, lambda: print(answer))
    return EXIT_OK


