def ask_options(args):
    opts = []
    for spec in args.option or []:
        value, _, rest = spec.partition("=")
        label, _, hint = rest.partition("|")
        opts.append({"value": value, "label": label or value, "hint": hint})
    if args.options_json:
        opts += json.loads(Path(args.options_json).read_text() if args.options_json != "-" else sys.stdin.read())
    if args.options_from:
        if not args.tv:
            raise TvError("--options-from needs --tv")
        ctx = ctx_for(argparse.Namespace(profile=args.tv))
        for r in inventory_rows(ctx):
            if r["class"] == args.options_from and not r["locked"]:
                opts.append({"value": r["package"], "label": r["note"] or r["package"],
                             "hint": r["package"] + ("" if r["enabled"] else " (currently off)"),
                             "checked": r["enabled"]})
    for o in opts:
        if args.checked and o["value"] in args.checked:
            o["checked"] = True
    return opts


def cmd_ask(args):
    """Ask the owner in the dashboard and wait for the answer (exit 2 = no answer: fall back to chat)."""
    ensure_ui()
    body = {"kind": args.kind, "title": args.title, "body": args.body or "", "tv": args.tv,
            "options": ask_options(args)}
    if args.kind == "confirm":
        body["options"] = []
    item = ui_call("POST", "/api/ask", body)
    viewers = ui_call("GET", "/api/state", timeout=20).get("viewers", 0)
    if not viewers and not args.no_open and shutil.which("open"):
        subprocess.Popen(["open", f"http://127.0.0.1:{UI_PORT}" + (f"/#tv={args.tv}" if args.tv else "")])
    desktop_notify("TV agent needs your input", args.title)
    if not args.json:
        print(f"asked in the dashboard (http://127.0.0.1:{UI_PORT}), waiting up to {args.timeout}s…", file=sys.stderr)
    deadline = time.time() + args.timeout
    while True:
        left = deadline - time.time()
        if left <= 0:
            item = ui_call("POST", f"/api/ask/{item['id']}/cancel", {"reason": "timeout"})
            break
        item = ui_call("GET", f"/api/ask/{item['id']}?wait={min(25, left):.0f}", timeout=40)
        if item["status"] != "open":
            break
    result = {"id": item["id"], "status": item["status"], "answer": item["answer"]}
    emit(args, result, lambda: print(json.dumps(result["answer"]) if item["status"] == "answered"
                                     else f"no answer ({item['status']}) – ask in chat instead"))
    return EXIT_OK if item["status"] == "answered" else EXIT_USER


