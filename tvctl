    p.add_argument("--no-open", action="store_true", help="don't open the browser")

    p = sub.add_parser("keys", help="remote button remapping")
    ksub = p.add_subparsers(dest="keys_cmd", required=True)
    for name, help_ in (("capture", "show scan codes of pressed buttons"), ("learn", "interactive remap"),
                        ("set", "map a button"), ("rm", "unmap a button"), ("push", "send the mapping to the TV")):
        kp = ksub.add_parser(name, help=help_)
        kp.add_argument("--json", action="store_true", default=argparse.SUPPRESS)
        kp.add_argument("profile")
        kp.set_defaults(fn=cmd_keys)
        if name == "capture":
            kp.add_argument("--seconds", type=int, default=20)
        if name in ("set", "rm"):
            kp.add_argument("scan", type=int)
        if name == "set":
            kp.add_argument("--open", help="catalog id or package to launch")
            kp.add_argument("--action", help="intent action to send (with --package)")
            kp.add_argument("--package")
            kp.add_argument("--label")

    args = ap.parse_args()
    try:
        sys.exit(args.fn(args))
    except TvError as e:
        if args.json:
            print(json.dumps({"error": str(e)}))
        else:
            print(f"error: {e}", file=sys.stderr)
        sys.exit(EXIT_ERR)
    except KeyboardInterrupt:
        sys.exit(EXIT_USER)


if __name__ == "__main__":
    main()
