def inventory_rows(ctx, mem=False, with_plan=False):
    """Every package with its class, profile decision and (optionally) RAM and planned effect."""
    pss = ctx.dev.pss_by_process() if mem else {}
    catalog_names = {a["package"]: (i, a["name"]) for i, a in ctx.catalog.items()}
    apps = ctx.prof["apps"]
    keep, off, rm = set(apps.get("keep", [])), set(apps.get("disable", [])), set(apps.get("uninstall", []))
    installs = {ctx.app(i)["package"] for i in ctx.install_ids()}
    live, _ = live_tv(ctx.presets)
    effects = {}
    if with_plan:
        for a in make_plan(ctx):
            if a["status"] != "skipped":
                effects[a["target"]] = f"{a['action']} ({a['status']})" if a["status"] not in ("todo",) else a["action"]
    rows = []
    for pkg, info in ctx.pkgs.items():
        cls, note, preset = ctx.classifier.classify(pkg)
        if info["user"] and cls == "unknown":
            cls = "user"
            if pkg in catalog_names:
                note = f"{catalog_names[pkg][1]} (catalog: {catalog_names[pkg][0]})"
        decision = ("install" if pkg in installs else "keep" if pkg in keep else "disable" if pkg in off
                    else "uninstall" if pkg in rm else "auto")
        locked = "live-tv" if pkg in live else "core" if cls == "core" else "catalog" if pkg in installs \
            else "unknown" if cls == "unknown" else None
        rows.append({"package": pkg, "enabled": info["enabled"], "user": info["user"], "class": cls, "note": note,
                     "preset": preset, "decision": decision, "locked": locked, "effect": effects.get(pkg),
                     "pss_mb": sum(v for proc, v in pss.items() if proc == pkg or proc.startswith(pkg + ":"))
                     if pss else None})
    return rows


