class UiClient:
    """Best-effort event mirror from CLI runs to the dashboard."""
    def __init__(self):
        try:
            self.token = UI_TOKEN_FILE.read_text().strip()
        except OSError:
            self.token = None

    def send(self, event):
        if not self.token:
            return
        try:
            req = urllib.request.Request(f"http://127.0.0.1:{UI_PORT}/api/ingest", data=json.dumps(event).encode(),
                                         headers={"Content-Type": "application/json", "X-Token": self.token})
            urllib.request.urlopen(req, timeout=0.5).read()
        except Exception:
            self.token = None  # dashboard not running; stop trying


def ui_running():
    try:
        with socket.create_connection(("127.0.0.1", UI_PORT), timeout=0.3):
            return True
    except OSError:
        return False


def ensure_ui():
    """Start the dashboard in the background when a workflow starts (TVCTL_NO_UI=1 to skip)."""
    if os.environ.get("TVCTL_NO_UI") or ui_running():
        return
    log = open(STATE_DIR / "ui.log", "a")
    subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "ui", "--no-open"], stdout=log, stderr=log,
                     stdin=subprocess.DEVNULL, start_new_session=True, cwd=ROOT)
    for _ in range(30):
        if ui_running():
            break
        time.sleep(0.1)
    print(f"dashboard: http://127.0.0.1:{UI_PORT}", file=sys.stderr)
    if sys.stdout.isatty() and shutil.which("open"):
        subprocess.Popen(["open", f"http://127.0.0.1:{UI_PORT}"])


def ui_call(method, path, body=None, timeout=10):
    """Call the dashboard API as the agent. Raises TvError if it is not running."""
    try:
        token = UI_TOKEN_FILE.read_text().strip()
    except OSError:
        raise TvError("dashboard not running (start it: ./tvctl ui)")
    req = urllib.request.Request(f"http://127.0.0.1:{UI_PORT}{path}", method=method,
                                 data=json.dumps(body).encode() if body is not None else None,
                                 headers={"Content-Type": "application/json", "X-Token": token})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read())
    except urllib.error.HTTPError as e:
        try:
            msg = json.loads(e.read()).get("error")
        except Exception:
            msg = str(e)
        raise TvError(msg)
    except (urllib.error.URLError, OSError) as e:
        raise TvError(f"dashboard not reachable: {e}")


