def set_toml_array(text, section, key, values):
    """Rewrite `key = [...]` inside [section], keeping per-item comments of entries that stay."""
    sec = re.search(rf"^\[{re.escape(section)}\]\n(?:(?!^\[).*\n?)*", text, re.M)
    if not sec:
        raise TvError(f"profile has no [{section}] section")
    body = sec.group(0)
    m = re.search(rf"^{key}\s*=\s*\[(.*?)\]", body, re.M | re.S)
    old_lines = {}
    if m:
        for line in m.group(1).splitlines():
            q = re.search(r'"([^"]+)"', line)
            if q:
                old_lines[q.group(1)] = line.strip()
    items = [old_lines.get(v, f'"{v}",') for v in values]
    items = [i if re.search(r'"\s*,', i) else re.sub(r'(")(\s*#|$)', r'\1,\2', i, count=1) for i in items]
    new = f"{key} = []" if not items else f"{key} = [\n" + "".join(f"  {i}\n" for i in items) + "]"
    if m:
        body = body[:m.start()] + new + body[m.end():]
    else:
        body = body.rstrip("\n") + f"\n{new}\n\n"
    return text[:sec.start()] + body + text[sec.end():]


def set_app_decision(profile, pkg, decision):
    """decision: auto | keep | disable | uninstall. Edits profiles/<tv>.toml."""
    prof = load_profile(profile)
    apps = prof["apps"]
    lists = {k: [p for p in apps.get(k, []) if p != pkg] for k in ("keep", "disable", "uninstall")}
    if decision in lists:
        lists[decision].append(pkg)
    elif decision != "auto":
        raise TvError(f"unknown decision {decision}")
    text = prof["_path"].read_text()
    for key, values in lists.items():
        if values != apps.get(key, []) or (key == "uninstall" and decision == "uninstall"):
            text = set_toml_array(text, "apps", key, values)
    tomllib.loads(text)  # never write a broken profile
    prof["_path"].write_text(text)


