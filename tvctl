ANIMATION_KEYS = ("window_animation_scale", "transition_animation_scale", "animator_duration_scale")


class TvError(Exception):
    pass


# ---------------------------------------------------------------- adb / device

def find_adb():
    for cand in (shutil.which("adb"),
                 Path.home() / "Library/Android/sdk/platform-tools/adb",
                 Path.home() / "Android/Sdk/platform-tools/adb",
                 "/opt/homebrew/bin/adb", "/usr/local/bin/adb"):
        if cand and Path(cand).exists():
            return str(cand)
    raise TvError("adb not found – install Android platform-tools")


def run(args, timeout=60):
    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        raise TvError(f"timed out: {' '.join(args[:4])}…")
    return p.returncode, p.stdout.replace("\r", ""), p.stderr.replace("\r", "")


class Device:
    def __init__(self, host, port=5555):
        self.addr = f"{host}:{port}"
        self.adb_bin = find_adb()

    def adb(self, *args, timeout=60):
        return run([self.adb_bin, "-s", self.addr, *args], timeout=timeout)

    def sh(self, script, timeout=60):
        _, out, _ = self.adb("shell", script, timeout=timeout)
        return out.strip()

    def state(self):
        _, out, err = self.adb("get-state", timeout=10)
        text = (out + err).strip()
        if "unauthorized" in text:
            return "unauthorized"
        return "device" if text == "device" else "offline"

    def connect(self, wait=0):
        """Connect; with wait>0 keep retrying (e.g. while the owner accepts the ADB prompt)."""
        deadline = time.time() + wait
        told = False
        while True:
            run([self.adb_bin, "connect", self.addr], timeout=15)
            st = self.state()
            if st == "device":
                return
            if time.time() >= deadline:
                if st == "unauthorized":
                    raise TvError("TV refused ADB: accept 'Allow USB debugging?' on the TV "
                                  "(tick 'Always allow from this computer') and retry")
                raise TvError(f"cannot reach {self.addr}: check the IP, that the TV is on, "
                              "and that Developer options > USB debugging is on")
            if st == "unauthorized" and not told:
                print("→ Accept 'Allow USB debugging?' on the TV (tick 'Always allow')…", file=sys.stderr)
                told = True
            time.sleep(3)

    def prop(self, name):
        return self.sh(f"getprop {name}")

    def props(self):
        names = ["ro.product.manufacturer", "ro.product.model", "ro.product.device", "ro.product.name",
                 "ro.build.version.release", "ro.build.version.sdk", "ro.serialno", "ro.product.cpu.abi"]
        out = self.sh("; ".join(f'echo "{n}=$(getprop {n})"' for n in names))
        return dict(line.split("=", 1) for line in out.splitlines() if "=" in line)

    def packages(self):
        """{pkg: {"enabled": bool, "user": bool}} for every installed package."""
        out = self.sh("pm list packages; echo ---; pm list packages -d; echo ---; pm list packages -3")
        all_, disabled, user = (
            {l.split(":", 1)[1].strip() for l in part.splitlines() if l.startswith("package:")}
            for part in out.split("---"))
        return {p: {"enabled": p not in disabled, "user": p in user} for p in sorted(all_)}

    def setting(self, ns, key):
        v = self.sh(f"settings get {ns} {key}")
        return None if v == "null" else v

    def home(self):
        out = self.sh("cmd package resolve-activity --brief -a android.intent.action.MAIN "
                      "-c android.intent.category.HOME")
        return out.splitlines()[-1].strip() if out else ""

    def a11y_enabled(self):
        v = self.setting("secure", "enabled_accessibility_services") or ""
        return [s for s in v.split(":") if s]

    def running(self, pkg):
        return bool(self.sh(f"pidof {pkg}"))

    def version(self, pkg):
        m = re.search(r"versionName=(\S+)", self.sh(f"dumpsys package {pkg}"))
        return m.group(1) if m else None

    def mem_available_mb(self):
        m = re.search(r"MemAvailable:\s+(\d+)", self.sh("cat /proc/meminfo"))
        return int(m.group(1)) // 1024 if m else None

    def pss_by_process(self):
        out = self.sh("dumpsys meminfo", timeout=90)
        block = out.split("Total PSS by process:", 1)[-1].split("Total PSS by OOM", 1)[0]
        res = {}
        for m in re.finditer(r"([\d,]+)K: (\S+) \(pid", block):
            res[m.group(2)] = int(m.group(1).replace(",", "")) // 1024
        return res

    def screencap(self):
        """PNG of what the TV shows right now (DRM-protected video shows up black)."""
        for attempt in (0, 1):
            try:
                p = subprocess.run([self.adb_bin, "-s", self.addr, "exec-out", "screencap", "-p"],
                                   capture_output=True, timeout=15)
            except subprocess.TimeoutExpired:
                raise TvError("screenshot timed out")
            if p.stdout.startswith(b"\x89PNG"):
                return p.stdout
            if attempt == 0:  # not connected yet (e.g. after a router restart): connect once and retry
                run([self.adb_bin, "connect", self.addr], timeout=10)
        raise TvError("could not take a screenshot: " + (p.stderr.decode(errors="replace").strip()[-200:] or "TV unreachable"))

    def reboot_and_wait(self, timeout=240):
        self.adb("reboot")
        time.sleep(10)
        deadline = time.time() + timeout
        while time.time() < deadline:
            run([self.adb_bin, "connect", self.addr], timeout=10)
            if self.state() == "device" and self.prop("sys.boot_completed") == "1":
                time.sleep(15)  # let the launcher and services settle
                return
            time.sleep(5)
        raise TvError(f"TV did not come back within {timeout // 60} minutes")

    def tv_settings(self):
        keys = [("secure", "screensaver_components"), ("secure", "screensaver_enabled")] + \
               [("global", k) for k in ANIMATION_KEYS]
        return {k: self.setting(ns, k) for ns, k in keys}

    def broadcast(self, component, action, extras=""):
        out = self.sh(f"am broadcast -f 32 -n {component} -a {action} {extras}")
        m = re.search(r'result=(-?\d+)(?:, data="(.*)")?', out, re.S)
        if not m:
            raise TvError(f"broadcast failed: {out[-200:]}")
        return int(m.group(1)), (m.group(2) or "")


# ---------------------------------------------------------------- config

def load_toml(path):
    with open(path, "rb") as f:
        return tomllib.load(f)


def load_catalog():
    return load_toml(CATALOG_FILE)


def profile_path(arg):
    p = Path(arg)
    if p.suffix == ".toml" and p.exists():
        return p
    p = PROFILES_DIR / f"{arg}.toml"
    if not p.exists():
        raise TvError(f"no profile {p} (create one with: tvctl init {arg} --host IP)")
    return p


def load_profile(arg):
    path = profile_path(arg)
    prof = load_toml(path)
    prof["_path"] = path
    tv = prof.setdefault("tv", {})
    if "host" not in tv:
        raise TvError(f"{path}: [tv].host missing")
    tv.setdefault("name", path.stem)
    for section in ("apps", "home", "keys"):
        prof.setdefault(section, {})
    return prof


def all_presets():
    return {p.stem: load_toml(p) for p in sorted(PRESETS_DIR.glob("*.toml")) if not p.name.startswith("_")}


def active_presets(names):
    presets = all_presets()
    missing = [n for n in names if n not in presets]
    if missing:
        raise TvError(f"unknown preset(s): {', '.join(missing)}")
    return [p for n, p in presets.items() if n in names or p.get("preset", {}).get("always")]


def detect_presets(props, pkgs):
    found = []
    for name, p in all_presets().items():
        if p.get("preset", {}).get("always"):
            continue
        match = p.get("match", {})
        manu = [m.lower() for m in match.get("manufacturer", [])]
        if manu and props.get("ro.product.manufacturer", "").lower() in manu:
            found.append(name)
        elif any(pkg in pkgs for pkg in match.get("packages_any", [])):
            found.append(name)
    return found


class Classifier:
    def __init__(self, presets):
        self.exact, self.globs = {}, []
        for p in presets:
            pname = p.get("preset", {}).get("name", "?")
            for cls in CLASS_PRIORITY:
                for pattern, note in p.get(cls, {}).items():
                    entry = (cls, note, pname)
                    if any(c in pattern for c in "*?["):
                        self.globs.append((pattern, entry))
                    elif pattern not in self.exact or CLASS_PRIORITY[cls] < CLASS_PRIORITY[self.exact[pattern][0]]:
                        self.exact[pattern] = entry

    def classify(self, pkg):
        if pkg in self.exact:
            return self.exact[pkg]
        hits = [e for pat, e in self.globs if fnmatch.fnmatchcase(pkg, pat)]
        return min(hits, key=lambda e: CLASS_PRIORITY[e[0]]) if hits else ("unknown", "", None)


def merged(presets, section):
    out = {}
    for p in presets:
        out.update(p.get(section, {}))
    return out


def stock_launcher(presets):
    stock, home = [], None
    for p in presets:
        launcher = p.get("launcher", {})
        stock += [s for s in launcher.get("stock", []) if s not in stock]
        home = home or launcher.get("stock_home")
    return stock, home


def live_tv(presets):
    """(protected packages, player package) from the presets' [live_tv] sections."""
    pkgs, player = set(), None
    for p in presets:
        section = p.get("live_tv", {})
        pkgs |= set(section.get("packages", []))
        player = player or section.get("player")
    return pkgs, player


def live_tv_status(dev, presets, pkgs):
    inputs = sorted(set(re.findall(r"TvInputInfo\{id=([^,]+),", dev.sh("dumpsys tv_input"))))
    tuners = [i for i in inputs if not re.search(r"passthrough|hdmi", i, re.I)]
    rows = dev.sh("content query --uri content://android.media.tv/channel --projection _id")
    protected, player = live_tv(presets)
    return {"tuner_inputs": tuners, "external_inputs": len(inputs) - len(tuners),
            "channels": sum(1 for l in rows.splitlines() if l.startswith("Row:")),
            "player": player, "player_enabled": bool(player and pkgs.get(player, {}).get("enabled")),
            "protected_disabled": sorted(p for p in protected if p in pkgs and not pkgs[p]["enabled"])}


# ---------------------------------------------------------------- discovery & preparation guide

DOSSIER_PROPS = ["ro.product.brand", "ro.product.manufacturer", "ro.product.model", "ro.product.name",
                 "ro.product.device", "ro.build.fingerprint", "ro.build.version.release", "ro.build.version.sdk",
                 "ro.build.version.security_patch", "ro.build.version.incremental", "ro.board.platform",
                 "ro.hardware", "ro.product.cpu.abi", "ro.build.characteristics", "persist.sys.locale",
                 "ro.product.locale", "persist.sys.timezone", "ro.serialno"]
DOSSIER_SETTINGS = [("global", "adb_enabled"), ("global", "development_settings_enabled"),
                    ("global", "hdmi_control_enabled"), ("global", "hdmi_control_auto_wakeup_enabled"),
                    ("global", "stay_on_while_plugged_in"), ("global", "auto_time"),
                    ("system", "screen_off_timeout"), ("secure", "sleep_timeout"),
                    ("secure", "screensaver_components"), ("global", "window_animation_scale")]
# Settings a guide step may change itself ("let the app do it"): harmless, reversible TV conveniences only.
AUTO_SETTINGS = {("global", "hdmi_control_enabled"), ("global", "hdmi_control_auto_wakeup_enabled"),
                 ("global", "hdmi_control_auto_device_off_enabled"), ("system", "screen_off_timeout"),
                 ("secure", "sleep_timeout")}


def discover(ctx):
    """Everything worth knowing about this TV before changing it. Saved as state/<tv>/dossier.json."""
    dev = ctx.dev
    sep = "@@SEP@@"
    out = dev.sh(f"""{'; '.join(f'echo "{n}=$(getprop {n})"' for n in DOSSIER_PROPS)}; echo {sep};
        grep -c ^processor /proc/cpuinfo; echo {sep}; grep -E 'MemTotal' /proc/meminfo; echo {sep}; df -k /data | tail -1;
        echo {sep}; wm size; wm density; echo {sep}; ip -o -4 addr show 2>/dev/null; echo {sep};
        dumpsys account 2>/dev/null | grep -cE '^ *Account [{{]'; echo {sep};
        grep -E '^N: Name=' /proc/bus/input/devices; echo {sep}; cat /proc/uptime""", timeout=60)
    parts = out.split(sep)
    props = dict(l.split("=", 1) for l in parts[0].splitlines() if "=" in l)
    num = lambda t: int(re.search(r"\d+", t).group()) if re.search(r"\d+", t or "") else None
    df = parts[3].split()
    size = re.search(r"(\d+)x(\d+)", parts[4])
    nets = [{"iface": m.group(1), "ip": m.group(2)} for m in re.finditer(r"\d+: (\S+)\s+inet (\d+\.\d+\.\d+\.\d+)", parts[5])
            if m.group(1) != "lo"]
    remotes = [m.group(1) for m in re.finditer(r'Name="([^"]+)"', parts[7])]
    pkgs = ctx.pkgs
    counts = {}
    for pkg, info in pkgs.items():
        cls = ctx.classifier.classify(pkg)[0]
        cls = "user" if info["user"] and cls == "unknown" else cls
        counts[cls] = counts.get(cls, 0) + 1
    homes = ctx.dev.sh("cmd package query-activities --brief -a android.intent.action.MAIN -c android.intent.category.HOME")
    vending = ctx.installed("com.android.vending")
    live = live_tv_status(dev, ctx.presets, pkgs)
    d = {
        "taken": now_iso(), "tv": ctx.prof["tv"]["name"], "props": props,
        "brand": props.get("ro.product.brand") or props.get("ro.product.manufacturer"),
        "model": props.get("ro.product.model"), "android": props.get("ro.build.version.release"),
        "security_patch": props.get("ro.build.version.security_patch"), "firmware": props.get("ro.build.version.incremental"),
        "soc": props.get("ro.board.platform") or props.get("ro.hardware"),
        "cpu_cores": num(parts[1]), "ram_mb": (num(parts[2]) or 0) // 1024,
        "storage_total_gb": round(int(df[1]) / 1048576, 1) if len(df) > 3 else None,
        "storage_free_gb": round(int(df[3]) / 1048576, 1) if len(df) > 3 else None,
        "display": f"{size.group(1)}x{size.group(2)}" if size else None,
        "network": nets, "locale": props.get("persist.sys.locale") or props.get("ro.product.locale"),
        "timezone": props.get("persist.sys.timezone"),
        "play_store": vending, "play_store_version": ctx.dev.version("com.android.vending") if vending else None,
        "google_accounts": num(parts[6]) or 0,
        "remotes": [r for r in remotes if not re.search(r"virtual|keypad|DMIC|gpio", r, re.I)],
        "live_tv": live, "home": ctx.dev.home(),
        "launchers": sorted({l.strip().split("/")[0] for l in homes.splitlines() if "/" in l}),
        "settings": {f"{ns}:{k}": dev.setting(ns, k) for ns, k in DOSSIER_SETTINGS},
        "packages": {"total": len(pkgs), "classes": counts},
        "presets": [p.get("preset", {}).get("name") for p in ctx.presets],
        "uptime_h": round(float((parts[8].split() or ["0"])[0]) / 3600, 1),
    }
    d["notes"] = dossier_notes(d)
    (state_dir(ctx.prof) / "dossier.json").write_text(json.dumps(d, indent=1))
    return d


def dossier_notes(d):
    """Plain-language findings that matter for the setup."""
    notes = []
    if d["ram_mb"] and d["ram_mb"] < 2500:
        notes.append(("warn", f"Low RAM ({d['ram_mb']} MB): a lighter launcher and debloat help a lot"))
    if not d["play_store"]:
        notes.append(("warn", "No Play Store: apps must come from verified APKs in the catalog"))
    elif not d["google_accounts"]:
        notes.append(("warn", "No Google account signed in: Play Store installs need one"))
    if d["live_tv"]["tuner_inputs"]:
        notes.append(("info", f"Has a TV tuner; {d['live_tv']['channels']} channel(s) scanned"))
    if d["packages"]["classes"].get("unknown"):
        notes.append(("warn", f"{d['packages']['classes']['unknown']} unclassified package(s): classify before debloating"))
    if not [p for p in d["presets"] if p not in ("core", "streaming-apps")]:
        notes.append(("warn", "No brand preset matched: this brand is new to the project"))
    patch = d.get("security_patch") or ""
    if patch and patch < time.strftime("%Y-%m-%d", time.localtime(time.time() - 365 * 86400)):
        notes.append(("warn", f"Security patch {patch} is over a year old: check for a system update first"))
    return [{"level": lv, "text": t} for lv, t in notes]


def load_dossier(name):
    path = STATE_DIR / name / "dossier.json"
    return json.loads(path.read_text()) if path.exists() else None


def guide_path(name):
    return STATE_DIR / name / "guide.json"


def builtin_guide(ctx, dossier):
    """Preparation steps from the presets' [[prepare]] tables, filtered for this TV."""
    conditions = {
        "tuner": bool(dossier["live_tv"]["tuner_inputs"]),
        "play_store": dossier["play_store"],
        "hdmi": dossier["live_tv"]["external_inputs"] > 0,
        "low_ram": (dossier["ram_mb"] or 0) < 2500,
    }
    steps = [{"id": "adb", "title": "Developer options and USB debugging", "why": "Lets this app talk to the TV.",
              "path": ["Settings", "System", "About", "Build (click 7×)", "Developer options", "USB debugging"],
              "how": "Already done: the app is connected.", "check": {"type": "adb"}, "required": True}]
    for p in all_presets().values():
        name = p.get("preset", {}).get("name")
        if name not in dossier["presets"]:
            continue
        for st in p.get("prepare", []):
            if st.get("only_if") and not conditions.get(st["only_if"], False):
                continue
            steps.append({k: st[k] for k in ("id", "title", "why", "path", "how", "check", "auto", "required", "source")
                          if k in st} | {"from": name})
    return {"tv": ctx.prof["tv"]["name"], "source": "built-in", "created": now_iso(),
            "summary": "Generic preparation from the presets. Ask the agent to research this exact model for "
                       "model-specific menus.", "steps": [dict(s, status="todo") for s in steps]}


def validate_guide(guide):
    if not isinstance(guide.get("steps"), list) or not guide["steps"]:
        raise TvError("guide needs a non-empty steps list")
    ids = set()
    for st in guide["steps"]:
        if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,40}", str(st.get("id", ""))) or st["id"] in ids:
            raise TvError(f"step ids must be unique slugs: {st.get('id')!r}")
        ids.add(st["id"])
        if not st.get("title"):
            raise TvError(f"step {st['id']} needs a title")
        chk = st.get("check")
        if chk and chk.get("type") not in ("adb", "setting", "channels", "accounts", "package", "a11y"):
            raise TvError(f"step {st['id']}: unknown check type {chk.get('type')}")
        auto = st.get("auto")
        if auto and (auto.get("ns"), auto.get("key")) not in AUTO_SETTINGS:
            raise TvError(f"step {st['id']}: the app may only change {sorted(AUTO_SETTINGS)} by itself")
        st.setdefault("status", "todo")
        st["path"] = [str(x)[:60] for x in st.get("path", [])][:10]
    return guide


def load_guide(ctx, rebuild=False):
    path = guide_path(ctx.prof["tv"]["name"])
    if path.exists() and not rebuild:
        return json.loads(path.read_text())
    dossier = load_dossier(ctx.prof["tv"]["name"]) or discover(ctx)
    guide = builtin_guide(ctx, dossier)
    path.write_text(json.dumps(guide, indent=1))
    return guide


def save_guide(name, guide, keep_status_from=None):
    """Store a guide (e.g. the agent's researched one), keeping progress on steps with the same id."""
    guide = validate_guide(guide)
    old = {s["id"]: s for s in (keep_status_from or {}).get("steps", [])}
    for st in guide["steps"]:
        if st["id"] in old and old[st["id"]].get("status") in ("done", "verified", "skipped"):
            st["status"] = old[st["id"]]["status"]
    guide.setdefault("created", now_iso())
    guide["tv"] = name
    guide_path(name).write_text(json.dumps(guide, indent=1))
    return guide


def check_step(ctx, step):
    """True/False when the step can be verified over ADB, None when only the owner can tell."""
    chk = step.get("check")
    if not chk:
        return None
    t = chk["type"]
    if t == "adb":
        return True
    if t == "setting":
        return ctx.dev.setting(chk["ns"], chk["key"]) == str(chk["equals"])
    if t == "channels":
        return live_tv_status(ctx.dev, ctx.presets, ctx.pkgs)["channels"] >= int(chk.get("min", 1))
    if t == "accounts":
        n = ctx.dev.sh("dumpsys account 2>/dev/null | grep -cE '^ *Account [{]'")
        return int(n or 0) >= int(chk.get("min", 1))
    if t == "package":
        return ctx.enabled(chk["pkg"]) == bool(chk.get("enabled", True))
    if t == "a11y":
        return chk["component"] in ctx.dev.a11y_enabled()
    return None


def guide_step_action(ctx, step_id, what):
    """verify | done | skip | reset | auto. Returns the updated guide."""
    name = ctx.prof["tv"]["name"]
    guide = load_guide(ctx)
    step = next((s for s in guide["steps"] if s["id"] == step_id), None)
    if not step:
        raise TvError(f"no step {step_id}")
    if what == "auto":
        auto = step.get("auto")
        if not auto or (auto.get("ns"), auto.get("key")) not in AUTO_SETTINGS:
            raise TvError("this step can't be done by the app")
        ctx.dev.sh(f"settings put {auto['ns']} {auto['key']} {shlex.quote(str(auto['value']))}")
        what = "verify"
    if what == "verify":
        ok = check_step(ctx, step)
        step["status"] = "verified" if ok else ("todo" if ok is False else step["status"])
        step["checked"] = now_iso()
        step["last_check"] = {True: "ok", False: "not yet", None: "can't be checked automatically"}[ok]
    elif what in ("done", "skip", "reset"):
        step["status"] = {"done": "done", "skip": "skipped", "reset": "todo"}[what]
    else:
        raise TvError(f"unknown step action {what}")
    guide_path(name).write_text(json.dumps(guide, indent=1))
    return guide


# ---------------------------------------------------------------- state

def state_dir(prof):
    d = STATE_DIR / prof["tv"]["name"]
    d.mkdir(parents=True, exist_ok=True)
    return d


def now_iso():
    return datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds")


def take_snapshot(dev, prof, filename=None):
    snap = {"taken": now_iso(), "props": dev.props(), "settings": dev.tv_settings(), "packages": dev.packages()}
    name = filename or f"snapshot-{datetime.now():%Y%m%d-%H%M%S}.json"
    path = state_dir(prof) / name
    path.write_text(json.dumps(snap, indent=1))
    return path


def log_history(prof, actions):
    with open(state_dir(prof) / "history.jsonl", "a") as f:
        for a in actions:
            if a["status"] in ("done", "error"):
                f.write(json.dumps({"time": now_iso(), **{k: v for k, v in a.items() if k != "fn"}}) + "\n")


def to_jpeg(png, width=960, quality=70):
    """Downscale a PNG to a small JPEG with macOS sips (for the live view). Falls back to the PNG."""
    if not shutil.which("sips"):
        return png, "image/png"
    with tempfile.TemporaryDirectory() as d:
        src, dst = Path(d) / "s.png", Path(d) / "s.jpg"
        src.write_bytes(png)
        args = ["sips", "-s", "format", "jpeg", "-s", "formatOptions", str(quality)]
        if width:
            args += ["-Z", str(width)]
        r = subprocess.run(args + [str(src), "--out", str(dst)], capture_output=True, timeout=15)
        if r.returncode == 0 and dst.exists():
            return dst.read_bytes(), "image/jpeg"
    return png, "image/png"


def perf(dev, pkgs=None):
    """Performance snapshot: memory, swap, load, storage, top processes, package counts."""
    out = dev.sh("cat /proc/meminfo; echo ---; cat /proc/loadavg; echo ---; cat /proc/uptime; echo ---; df -k /data")
    mem_part, load_part, up_part, df_part = (out.split("---") + ["", "", "", ""])[:4]
    mem = {m.group(1): int(m.group(2)) // 1024 for m in re.finditer(r"^(\w+):\s+(\d+) kB", mem_part, re.M)}
    load = load_part.split()
    df = df_part.strip().splitlines()[-1].split() if df_part.strip() else []
    pss = dev.pss_by_process()
    pkgs = pkgs if pkgs is not None else dev.packages()
    return {
        "time": now_iso(),
        "mem_total_mb": mem.get("MemTotal"), "mem_available_mb": mem.get("MemAvailable"),
        "swap_total_mb": mem.get("SwapTotal"),
        "swap_used_mb": (mem.get("SwapTotal", 0) - mem.get("SwapFree", 0)) if "SwapTotal" in mem else None,
        "load1": float(load[0]) if load else None, "load5": float(load[1]) if len(load) > 1 else None,
        "uptime_s": int(float(up_part.split()[0])) if up_part.split() else None,
        "storage_total_gb": round(int(df[1]) / 1048576, 1) if len(df) > 3 else None,
        "storage_free_gb": round(int(df[3]) / 1048576, 1) if len(df) > 3 else None,
        "processes": len(pss),
        "top": [{"name": n, "mb": mb} for n, mb in sorted(pss.items(), key=lambda kv: -kv[1])[:12]],
        "packages": {"total": len(pkgs), "enabled": sum(1 for i in pkgs.values() if i["enabled"]),
                     "disabled": sum(1 for i in pkgs.values() if not i["enabled"]),
                     "user": sum(1 for i in pkgs.values() if i["user"])},
    }


def runs_dir(name):
    d = STATE_DIR / name / "runs"
    d.mkdir(parents=True, exist_ok=True)
    return d


def save_run(record):
    clean = {**record, "rounds": [[{k: v for k, v in a.items() if k != "fn"} for a in r] for r in record["rounds"]]}
    path = runs_dir(record["tv"]) / f"{record['id']}.json"
    path.write_text(json.dumps(clean, indent=1))
    return path


def list_runs(name):
    d = STATE_DIR / name / "runs"
    if not d.exists():
        return []
    return [json.loads(p.read_text()) for p in sorted(d.glob("*.json"), reverse=True)]


# ---------------------------------------------------------------- planning

def action(step, target, what, detail="", status="todo", fn=None, undo=None):
    """One planned change. `undo` records how to reverse it exactly (used by `tvctl revert`)."""
    return {"step": step, "target": target, "action": what, "detail": detail, "status": status, "fn": fn,
            "undo": undo}


class Ctx:
    def __init__(self, prof, dev):
        self.prof, self.dev = prof, dev
        self.catalog = load_catalog()
        self.presets = active_presets(prof["tv"].get("presets", []))
        self.classifier = Classifier(self.presets)
        self.quirks = merged(self.presets, "quirks")
        self.opened = set()
        self.refresh()

    def refresh(self):
        self.pkgs = self.dev.packages()

    def open_play_page(self, pkg):
        if pkg not in self.opened:  # once per run, not on every re-check
            self.opened.add(pkg)
            self.dev.sh(f"am start -a android.intent.action.VIEW -d market://details?id={pkg}")

    def app(self, app_id):
        if app_id not in self.catalog:
            raise TvError(f"'{app_id}' is not in apps.toml")
        return self.catalog[app_id]

    def installed(self, pkg):
        return pkg in self.pkgs

    def enabled(self, pkg):
        return self.pkgs.get(pkg, {}).get("enabled", False)

    def install_ids(self):
        return list(self.prof["apps"].get("install", []))

    def resolve_pkg(self, ref):
        """Catalog id or package name -> package name."""
        return self.catalog[ref]["package"] if ref in self.catalog else ref


def check_identity(ctx):
    want = ctx.prof["tv"].get("serial")
    got = ctx.dev.prop("ro.serialno")
    if want and got and want != got:
        raise TvError(f"this is not {ctx.prof['tv']['name']}: serial {got} != profile {want}")


def plan_baseline(ctx):
    if (state_dir(ctx.prof) / "baseline.json").exists():
        return []
    return [action("baseline", "packages", "snapshot", "first run: save the untouched package state",
                   fn=lambda: take_snapshot(ctx.dev, ctx.prof, "baseline.json"))]


def install_apk_fn(ctx, app, force=False):
    def fn():
        path = ROOT / app["file"]
        if not path.exists():
            if app.get("build"):
                raise TvError(f"{path} missing – build it: bash {app['build']}")
            raise TvError(f"{path} missing")
        if app.get("sha256"):
            digest = hashlib.sha256(path.read_bytes()).hexdigest()
            if digest != app["sha256"]:
                raise TvError(f"sha256 mismatch for {path.name}: {digest}")
        code, out, err = ctx.dev.adb("install", "-r", str(path), timeout=300)
        if "Success" not in out:
            raise TvError((out + err).strip()[-300:])
    return fn


def plan_install(ctx):
    acts = []
    for app_id in ctx.install_ids():
        app = ctx.app(app_id)
        pkg = app["package"]
        if ctx.installed(pkg):
            if not ctx.enabled(pkg):
                acts.append(action("install", pkg, "enable", app["name"],
                                   fn=lambda p=pkg: pm(ctx, "enable", p), undo={"op": "disable", "pkg": pkg}))
            continue
        if app["source"] == "apk":
            acts.append(action("install", pkg, "install", f"{app['name']} from {app['file']}",
                               fn=install_apk_fn(ctx, app), undo={"op": "uninstall", "pkg": pkg}))
        elif app["source"] == "play" and not ctx.installed("com.android.vending"):
            acts.append(action("install", pkg, "install", f"no Play Store on this device: add a verified APK for "
                               f"{app['name']} to apps.toml (prompts/verify-apk.md)", status="blocked"))
        elif app["source"] == "play":
            acts.append(action("install", pkg, "install", f"Install {app['name']} on the Play Store page "
                               "now open on the TV, then re-run apply", status="manual",
                               fn=lambda p=pkg: ctx.open_play_page(p)))
        else:
            acts.append(action("install", pkg, "missing", f"{app['name']} is not on this TV", status="skipped"))
    return acts


def plan_autostart(ctx):
    op = ctx.quirks.get("autostart_appop")
    if not op:
        return []
    acts = []
    for app_id in ctx.install_ids():
        app = ctx.app(app_id)
        pkg = app["package"]
        if app.get("autostart") and ctx.installed(pkg):
            current = ctx.dev.sh(f"appops get {pkg} {op}")
            if "allow" not in current:
                prev = re.search(rf"{op}: (\w+)", current)
                acts.append(action("autostart", pkg, "allow", f"vendor autostart app-op {op}",
                                   fn=lambda p=pkg: ctx.dev.sh(f"appops set {p} {op} allow"),
                                   undo={"op": "appop", "pkg": pkg, "name": op,
                                         "value": prev.group(1) if prev else "default"}))
    return acts


def plan_a11y(ctx):
    acts = []
    enabled = ctx.dev.a11y_enabled()
    for app_id in ctx.install_ids():
        app = ctx.app(app_id)
        pkg, comp = app["package"], app.get("a11y")
        if not comp or not ctx.installed(pkg):
            continue
        label = app.get("a11y_label", app["name"])
        if comp not in enabled:
            acts.append(action("a11y", pkg, "enable-service",
                               f"On the TV: Settings → System → Accessibility → {label} → On", status="manual"))
        elif not ctx.dev.running(pkg):
            acts.append(action("a11y", pkg, "rebind-service",
                               f"On the TV: Settings → System → Accessibility → {label} → Off, then On",
                               status="manual"))
    return acts


def keymap_string(ctx):
    parts = []
    for scan, k in sorted(ctx.prof["keys"].items(), key=lambda kv: int(kv[0])):
        if "action" in k:
            parts.append(f"{int(scan)}=action:{ctx.resolve_pkg(k['package'])}/{k['action']}")
        else:
            parts.append(f"{int(scan)}=app:{ctx.resolve_pkg(k['open'])}")
    return ";".join(parts)


def keymap_app(ctx):
    """The app that receives [keys] (Remote Remap): from the profile, else from the catalog."""
    for app_id in ctx.install_ids():
        app = ctx.app(app_id)
        if app.get("keymap"):
            return app
    return next((a for a in ctx.catalog.values() if a.get("keymap")), None)


def keymap_app_id(ctx):
    return next((i for i, a in ctx.catalog.items() if a.get("keymap")), None)


def push_keymap(ctx, raw):
    code, data = ctx.dev.broadcast(REMAP_RECEIVER, "com.nde.tvremap.SET_KEYMAP", f"--es keymap {shlex.quote(raw)}")
    if code != 1:
        raise TvError(f"Remote Remap rejected the key map: {data}")


def plan_keymap(ctx):
    app = keymap_app(ctx)
    if not app or not ctx.prof["keys"]:
        return []
    if not ctx.installed(app["package"]):
        return [action("keys", app["package"], "push", "waiting for Remote Remap to be installed", status="blocked")]
    raw = keymap_string(ctx)
    _, current = ctx.dev.broadcast(REMAP_RECEIVER, "com.nde.tvremap.GET_KEYMAP")
    if current == raw:
        return []
    return [action("keys", app["package"], "push", raw, fn=lambda: push_keymap(ctx, raw),
                   undo={"op": "keymap", "value": current})]


def pm(ctx, verb, pkg):
    cmd = {"disable": f"pm disable-user --user 0 {pkg}", "enable": f"pm enable --user 0 {pkg}"}[verb]
    out = ctx.dev.sh(cmd)
    if "new state" not in out:
        raise TvError(out[-200:] or f"{verb} failed")


def plan_packages(ctx):
    apps = ctx.prof["apps"]
    keep = set(apps.get("keep", []))
    wanted_off = set(apps.get("disable", []))
    protected = {ctx.app(i)["package"] for i in ctx.install_ids()}
    live, _ = live_tv(ctx.presets)
    acts = []
    for pkg in sorted(ctx.pkgs):
        if pkg in live:
            if ctx.enabled(pkg) and pkg in wanted_off:
                acts.append(action("packages", pkg, "disable", "refused: needed for live TV", status="error"))
            continue
        cls, note, _ = ctx.classifier.classify(pkg)
        on = ctx.enabled(pkg)
        if pkg in keep:
            if not on:
                acts.append(action("packages", pkg, "enable", "listed in keep", fn=lambda p=pkg: pm(ctx, "enable", p),
                                   undo={"op": "disable", "pkg": pkg}))
            continue
        if pkg in wanted_off:
            if cls == "core":
                acts.append(action("packages", pkg, "disable", f"refused: core package ({note})", status="error"))
            elif pkg in protected:
                acts.append(action("packages", pkg, "disable", "refused: in [apps].install", status="error"))
            elif on:
                acts.append(action("packages", pkg, "disable", note or "listed in disable",
                                   fn=lambda p=pkg: pm(ctx, "disable", p), undo={"op": "enable", "pkg": pkg}))
        elif cls == "bloat" and on and pkg not in protected and apps.get("debloat", True):
            acts.append(action("packages", pkg, "disable", note, fn=lambda p=pkg: pm(ctx, "disable", p),
                               undo={"op": "enable", "pkg": pkg}))
    for pkg in sorted(wanted_off - set(ctx.pkgs)):
        acts.append(action("packages", pkg, "disable", "not installed on this TV", status="skipped"))
    return acts


def plan_live_tv(ctx):
    """Runs in every workflow: live TV packages are switched back on if anything turned them off."""
    live, _ = live_tv(ctx.presets)
    return [action("live-tv", pkg, "enable", "live TV package must stay on", fn=lambda p=pkg: pm(ctx, "enable", p),
                   undo={"op": "disable", "pkg": pkg})
            for pkg in sorted(live) if ctx.installed(pkg) and not ctx.enabled(pkg)]


def uninstall_fn(ctx, pkg):
    def fn():
        _, out, err = ctx.dev.adb("uninstall", pkg, timeout=120)
        if "Success" not in out:
            raise TvError((out + err).strip()[-200:])
    return fn


def plan_user_apps(ctx):
    apps = ctx.prof["apps"]
    acts = []
    wanted = {ctx.app(i)["package"] for i in ctx.install_ids()}
    replaced = {old for i in ctx.install_ids() for old in ctx.app(i).get("replaces", [])}
    for pkg in sorted(replaced & set(ctx.pkgs)):
        acts.append(action("user-apps", pkg, "uninstall", "replaced by a newer catalog app (owner signs in again)",
                           status="confirm", fn=uninstall_fn(ctx, pkg),
                           undo={"op": "reinstall", "pkg": pkg}))
    for pkg in sorted(set(apps.get("uninstall", [])) - replaced):
        if pkg in ctx.pkgs and pkg not in wanted:
            acts.append(action("user-apps", pkg, "uninstall", "listed in [apps].uninstall (deletes its data)",
                               status="confirm", fn=uninstall_fn(ctx, pkg),
                           undo={"op": "reinstall", "pkg": pkg}))
    if apps.get("user_apps", "keep-others") == "remove-others":
        keep = set(apps.get("keep", [])) | wanted | replaced | set(apps.get("uninstall", []))
        for pkg, info in ctx.pkgs.items():
            if info["user"] and pkg not in keep:
                acts.append(action("user-apps", pkg, "uninstall", "user app not in install/keep (deletes its data)",
                                   status="confirm", fn=uninstall_fn(ctx, pkg),
                           undo={"op": "reinstall", "pkg": pkg}))
    return acts


def plan_launcher(ctx):
    choice = ctx.prof["home"].get("launcher")
    if not choice:
        return []
    stock, stock_home = stock_launcher(ctx.presets)
    acts = []
    if choice == "stock":
        for pkg in stock:
            if ctx.installed(pkg) and not ctx.enabled(pkg):
                acts.append(action("home", pkg, "enable", "restore stock home", fn=lambda p=pkg: pm(ctx, "enable", p)))
        if stock_home and ctx.dev.home() != stock_home:
            acts.append(action("home", stock_home, "set-home", "stock home",
                               fn=lambda: ctx.dev.sh(f"cmd package set-home-activity --user 0 {stock_home}")))
        return acts
    app = ctx.app(choice)
    pkg, home = app["package"], app.get("home")
    if not home:
        raise TvError(f"apps.toml: {choice} has no `home` activity")
    missing = []
    if not ctx.installed(pkg):
        missing.append(f"{app['name']} installed")
    if app.get("a11y") and app["a11y"] not in ctx.dev.a11y_enabled():
        missing.append(f"its accessibility service on")
    if missing:
        return [action("home", pkg, "replace-stock", "waiting for: " + ", ".join(missing), status="blocked")]
    if ctx.dev.home() != home or any(ctx.enabled(p) for p in stock):
        def fn():
            for p in stock:  # stock home and setup wizard go together, see presets/google-tv.toml
                if ctx.enabled(p):
                    pm(ctx, "disable", p)
            ctx.dev.sh(f"cmd package set-home-activity --user 0 {home}")
            if ctx.dev.home() != home:
                raise TvError(f"home resolves to {ctx.dev.home()} instead of {home}")
        acts.append(action("home", pkg, "replace-stock", f"set {app['name']} as home, disable {', '.join(stock)}", fn=fn,
                           undo={"op": "launcher", "enable": [p for p in stock if ctx.enabled(p)],
                                 "home": ctx.dev.home()}))
    return acts


def plan_screensaver(ctx):
    choice = ctx.prof["home"].get("screensaver")
    if not choice:
        return []
    app = ctx.app(choice)
    comp = app.get("dream")
    if not comp:
        raise TvError(f"apps.toml: {choice} has no `dream` component")
    if not ctx.enabled(app["package"]):
        return [action("screensaver", comp, "set", f"waiting for {app['name']} to be installed/enabled", status="blocked")]
    if ctx.dev.setting("secure", "screensaver_components") == comp and ctx.dev.setting("secure", "screensaver_enabled") == "1":
        return []
    def fn():
        ctx.dev.sh(f"settings put secure screensaver_components {comp}; settings put secure screensaver_enabled 1")
    prev = {k: ctx.dev.setting("secure", k) for k in ("screensaver_components", "screensaver_enabled")}
    return [action("screensaver", comp, "set", app["name"], fn=fn,
                   undo={"op": "settings", "ns": "secure", "values": prev})]


def plan_animations(ctx):
    scale = ctx.prof["home"].get("animation_scale")
    if scale is None:
        return []
    want = f"{float(scale):g}"
    current = {k: ctx.dev.setting("global", k) for k in ANIMATION_KEYS}
    if all(v is not None and f"{float(v):g}" == want for v in current.values()):
        return []
    return [action("animations", "global", "set", f"{want}x",
                   fn=lambda: ctx.dev.sh("; ".join(f"settings put global {k} {want}" for k in ANIMATION_KEYS)),
                   undo={"op": "settings", "ns": "global", "values": current})]


# A run is any combination of these steps. Dependencies are pulled in by the step itself
# (home installs and sets up its launcher before switching off the original one, etc.).
STEPS = {
    "apps": "Install the profile's apps and remove the ones you don't want",
    "debloat": "Disable bloat and tracking (presets plus your disable list)",
    "home": "Switch to the chosen home screen: installs the launcher first, then switches off the original",
    "screensaver": "Set the chosen screensaver (installs it if needed)",
    "tweaks": "Animation speed",
    "buttons": "Push the remote button map (installs Remote Remap if needed)",
}
RECIPES = {
    "full": list(STEPS),
    "apps-only": ["apps"],
    "cleanup": ["debloat", "tweaks"],
    "home-screen": ["home"],
}


def parse_steps(only=None, skip=None, recipe=None):
    steps = list(RECIPES[recipe]) if recipe else list(STEPS)
    if only:
        steps = [x.strip() for x in only.split(",") if x.strip()]
    if skip:
        steps = [x for x in steps if x not in {y.strip() for y in skip.split(",")}]
    bad = [x for x in steps if x not in STEPS]
    if bad:
        raise TvError(f"unknown step(s) {', '.join(bad)}; steps: {', '.join(STEPS)}")
    return steps


def plan_app_setup(ctx, app_id):
    """Install + autostart + accessibility for one catalog app, whether or not it is in [apps].install."""
    if not app_id or app_id not in ctx.catalog or ctx.catalog[app_id]["source"] == "system":
        return []
    pkg = ctx.catalog[app_id]["package"]
    saved = ctx.prof["apps"].get("install", [])
    ctx.prof["apps"]["install"] = list(saved) + ([app_id] if app_id not in saved else [])
    try:
        return [a for planner in (plan_install, plan_autostart, plan_a11y) for a in planner(ctx) if a["target"] == pkg]
    finally:
        ctx.prof["apps"]["install"] = saved


def make_plan(ctx, steps=None):
    steps = set(steps or STEPS)
    home = ctx.prof["home"]
    acts = plan_baseline(ctx) + plan_live_tv(ctx)
    if "apps" in steps:
        acts += plan_install(ctx) + plan_autostart(ctx) + plan_a11y(ctx) + plan_user_apps(ctx)
    if "buttons" in steps and ctx.prof["keys"]:
        acts += plan_app_setup(ctx, keymap_app_id(ctx)) + plan_keymap(ctx)
    if "debloat" in steps:
        acts += plan_packages(ctx)
    if "home" in steps and home.get("launcher"):
        if home["launcher"] != "stock":
            acts += plan_app_setup(ctx, home["launcher"])
        acts += plan_launcher(ctx)
    if "screensaver" in steps and home.get("screensaver"):
        acts += plan_app_setup(ctx, home["screensaver"]) + plan_screensaver(ctx)
    if "tweaks" in steps:
        acts += plan_animations(ctx)
    seen, out = set(), []
    for a in acts:  # a step's dependency may already be planned by another step
        key = (a["target"], a["action"])
        if key not in seen:
            seen.add(key)
            out.append(a)
    return out


# ---------------------------------------------------------------- output

def public(acts):
    return [{k: v for k, v in a.items() if k != "fn"} for a in acts]


def emit(args, data, human):
    if args.json:
        print(json.dumps(data, indent=1))
    else:
        human()


def print_actions(acts):
    if not acts:
        print("  nothing to do – the TV matches the profile")
    for a in acts:
        print(f"  [{a['status']:<8}] {a['step']:<11} {a['action']:<14} {a['target']}"
              + (f"\n{'':>39}{a['detail']}" if a["detail"] else ""))


# ---------------------------------------------------------------- commands

def ctx_for(args):
    prof = load_profile(args.profile)
    dev = Device(prof["tv"]["host"], prof["tv"].get("port", 5555))
    dev.connect(wait=getattr(args, "wait", 0))
    ctx = Ctx(prof, dev)
    check_identity(ctx)
    return ctx


def cmd_plan(args):
    ensure_ui()
    ctx = ctx_for(args)
    acts = make_plan(ctx, parse_steps(args.only, args.skip, args.recipe))
    emit(args, {"tv": ctx.prof["tv"]["name"], "actions": public(acts)},
         lambda: (print(f"Plan for {ctx.prof['tv']['name']} ({ctx.dev.addr}):"), print_actions(acts)))
    return EXIT_OK


def confirm(question):
    if not sys.stdin.isatty():
        return False
    return input(f"{question} [y/N] ").strip().lower() in ("y", "yes")


# ---------------------------------------------------------------- workflow engine

class Hooks:
    """How a Workflow talks to its driver (terminal, dashboard). Override what you need."""
    def emit(self, event): pass
    def confirm(self, actions):
        """Return the indexes of `actions` (all status=confirm) the owner approved."""
        return set()
    def wait(self, waiting):
        """Owner has to act on the TV. Return True to re-check, False to stop."""
        return False
    def stopped(self):
        return False


class Workflow:
    """One run: connect → measure → plan → apply rounds (pausing for the owner) → reboot → measure → save.

    mode: "apply" | "plan" | "verify" (reboot + measure) | "restore" (back to the TV's defaults)
    """
    def __init__(self, profile, mode="apply", hooks=None, yes=False, reboot=False, measure=True, source="cli",
                 revert_run=None, keep_reverted=False, app_action=None, app=None, track=True, steps=None):
        self.profile_name, self.mode, self.hooks = profile, mode, hooks or Hooks()
        self.revert_run, self.keep_reverted = revert_run, keep_reverted
        self.app_action, self.app_ref, self.track = app_action, app, track
        self.steps = steps or list(STEPS)
        self.yes, self.reboot, self.measure, self.source = yes, reboot, measure, source
        self.ctx = None
        self.record = {"id": datetime.now().strftime("%Y%m%d-%H%M%S"), "tv": None, "mode": mode, "source": source,
                       "started": now_iso(), "finished": None, "outcome": "running", "phases": [],
                       "perf_before": None, "perf_after": None, "rounds": [], "summary": {}, "status": None,
                       "steps": steps or list(STEPS) if mode in ("apply", "plan") else None}

    def emit(self, type_, **data):
        self.hooks.emit({"type": type_, "tv": self.record["tv"], "run": self.record["id"], "time": now_iso(), **data})

    def phase(self, name, fn):
        entry = {"name": name, "status": "running", "started": now_iso()}
        self.record["phases"].append(entry)
        self.emit("phase", name=name, status="running")
        try:
            result = fn()
            entry.update(status="done", finished=now_iso())
            self.emit("phase", name=name, status="done")
            return result
        except Exception as e:
            entry.update(status="error", finished=now_iso(), detail=str(e))
            self.emit("phase", name=name, status="error", detail=str(e))
            raise

    def run(self):
        prof = load_profile(self.profile_name)
        self.record["tv"] = prof["tv"]["name"]
        self.emit("run", status="running", mode=self.mode, source=self.source, steps=self.record.get("steps"))
        try:
            self.phase("connect", lambda: self._connect(prof))
            if self.measure:
                self.record["perf_before"] = self.phase("measure-before", self._measure)
                self.emit("perf", which="before", data=self.record["perf_before"])
            if self.mode == "plan":
                acts = self.phase("plan", lambda: make_plan(self.ctx, self.steps))
                self._round(acts, execute=False)
                self.record["outcome"] = "ok"
            elif self.mode == "apply":
                self.phase("apply", self._apply)
            elif self.mode == "restore":
                self.phase("restore", self._restore)
            elif self.mode == "revert":
                self.phase("revert", self._revert)
            elif self.mode == "app":
                self.phase("app", self._app)
            if self.mode != "plan" and self.record["outcome"] in ("ok", "running") and \
                    (self.mode == "verify" or (self.reboot and self.record["summary"].get("changed"))):
                self.phase("reboot", self.ctx.dev.reboot_and_wait)
                self.ctx.refresh()
            if self.measure and self.mode != "plan":
                self.record["perf_after"] = self.phase("measure-after", self._measure)
                self.emit("perf", which="after", data=self.record["perf_after"])
            self.record["status"] = self.phase("verify", lambda: status_data(self.ctx))
            if self.record["outcome"] == "running":
                self.record["outcome"] = "ok"
        except StopRun:
            self.record["outcome"] = "stopped"
        except Exception as e:  # report every failure to the driver, then re-raise for the CLI
            self.record["outcome"] = "error"
            self.record["error"] = str(e)
            self.emit("log", level="error", msg=str(e))
        finally:
            self.record["finished"] = now_iso()
            if self.record["tv"] and self.mode != "plan":
                save_run(self.record)
            self.emit("run", status=self.record["outcome"], record=self.summary())
        return self.record

    def summary(self):
        r = self.record
        pb, pa = r["perf_before"] or {}, r["perf_after"] or {}
        return {"id": r["id"], "tv": r["tv"], "mode": r["mode"], "source": r["source"], "outcome": r["outcome"],
                "steps": r.get("steps"),
                "started": r["started"], "finished": r["finished"], "summary": r["summary"],
                "mem_before": pb.get("mem_available_mb"), "mem_after": pa.get("mem_available_mb"),
                "error": r.get("error")}

    # -- phases

    def _connect(self, prof):
        dev = Device(prof["tv"]["host"], prof["tv"].get("port", 5555))
        dev.connect(wait=30)
        self.ctx = Ctx(prof, dev)
        check_identity(self.ctx)

    def _measure(self):
        return perf(self.ctx.dev, self.ctx.pkgs)

    def _check_stop(self):
        if self.hooks.stopped():
            raise StopRun()

    def _round(self, acts, execute=True):
        n = len(self.record["rounds"])
        for i, a in enumerate(acts):
            a["index"] = i
        self.record["rounds"].append(acts)
        self.emit("round", n=n, actions=public(acts), execute=execute)
        if not execute:
            return
        confirms = [a for a in acts if a["status"] == "confirm"]
        if confirms:
            approved = set(range(len(confirms))) if self.yes else self.hooks.confirm(public(confirms))
            for j, a in enumerate(confirms):
                a["status"] = "todo" if j in approved else "declined"
                self.emit("action", n=n, **public([a])[0])
        for a in acts:
            self._check_stop()
            if a["status"] not in ("todo", "manual") or not a["fn"]:
                continue
            if a["status"] == "todo":
                a["status"] = "running"
                self.emit("action", n=n, **public([a])[0])
            try:
                a["fn"]()
                if a["status"] == "running":
                    a["status"] = "done"
            except TvError as e:
                a["status"], a["detail"] = "error", str(e)
            self.emit("action", n=n, **public([a])[0])
        log_history(self.ctx.prof, acts)

    def _apply(self):
        changed = 0
        while True:
            self._check_stop()
            acts = make_plan(self.ctx, self.steps)
            self._round(acts)
            changed += sum(1 for a in acts if a["status"] == "done")
            waiting = [a for a in acts if a["status"] in ("manual", "blocked")]
            self.ctx.refresh()
            if len(self.record["rounds"]) >= 8:
                break
            if any(a["status"] == "done" for a in acts) and not waiting:
                continue  # e.g. an install unblocked a later step
            if waiting:
                self.emit("waiting", items=public(waiting))
                if self.hooks.wait(public(waiting)):
                    self.ctx.refresh()
                    continue
            break
        final = self.record["rounds"][-1]
        count = lambda *st: sum(1 for r in self.record["rounds"] for a in r if a["status"] in st)
        self.record["summary"] = {
            "changed": changed,
            "disabled": sum(1 for r in self.record["rounds"] for a in r if a["status"] == "done" and a["action"] == "disable"),
            "uninstalled": sum(1 for r in self.record["rounds"] for a in r if a["status"] == "done" and a["action"] == "uninstall"),
            "installed": sum(1 for r in self.record["rounds"] for a in r if a["status"] == "done" and a["action"] == "install"),
            "errors": count("error"),
            "waiting": [public([a])[0] for a in final if a["status"] in ("manual", "blocked", "declined")],
        }
        if any(a["status"] == "error" for a in final):
            self.record["outcome"] = "error"
        elif any(a["status"] in ("manual", "blocked") for a in final):
            self.record["outcome"] = "waiting"
        else:
            self.record["outcome"] = "ok"

    def _app(self):
        """Install or uninstall one app, without touching anything else on the TV."""
        ctx, name = self.ctx, self.record["tv"]
        app_id, app = catalog_app_for(ctx, self.app_ref)
        pkg = app["package"] if app else self.app_ref
        self.record["app"] = {"action": self.app_action, "id": app_id, "package": pkg}
        if self.app_action == "update":
            if not app or app["source"] != "apk":
                raise TvError("only APK apps from the catalog can be updated here (Play Store apps update themselves)")
            self._round([action("app", pkg, "update", f"{app['name']} → {app.get('version') or 'catalog APK'}",
                                fn=install_apk_fn(ctx, app))])
        elif self.app_action == "uninstall":
            roles = app_roles(ctx, pkg)
            if roles:
                raise TvError(f"{pkg} is used as {', '.join(roles)} in the profile – change that first")
            if not ctx.installed(pkg):
                acts = [action("app", pkg, "uninstall", "not installed", status="skipped")]
            elif ctx.pkgs[pkg]["user"]:
                acts = [action("app", pkg, "uninstall", "deletes the app and its data", status="confirm",
                               fn=uninstall_fn(ctx, pkg), undo={"op": "reinstall", "pkg": pkg, "app": app_id})]
            else:  # preinstalled: can only be switched off
                acts = [action("app", pkg, "disable", "preinstalled app: switched off (reversible)",
                               fn=lambda: pm(ctx, "disable", pkg), undo={"op": "enable", "pkg": pkg})]
            self._round(acts)
            if self.track and app_id and acts[0]["status"] in ("done", "skipped"):
                track_app(name, app_id, add=False)
        else:
            if not app:
                raise TvError(f"'{self.app_ref}' is not in apps.toml – add it there first (prompts/verify-apk.md)")
            if self.track:
                track_app(name, app_id, add=True)
                ctx.prof = load_profile(name)
            else:
                ctx.prof["apps"]["install"] = list(ctx.prof["apps"].get("install", [])) + [app_id]
            while True:  # install, then the app's own setup steps (autostart app-op, accessibility, key map)
                acts = [a for planner in (plan_install, plan_autostart, plan_a11y, plan_keymap)
                        for a in planner(ctx) if a["target"] == pkg]
                if not acts:
                    break
                self._round(acts)
                ctx.refresh()
                waiting = [a for a in acts if a["status"] in ("manual", "blocked")]
                if any(a["status"] == "error" for a in acts) or len(self.record["rounds"]) >= 6:
                    break
                if waiting:
                    self.emit("waiting", items=public(waiting))
                    if not self.hooks.wait(public(waiting)):
                        break
                    ctx.refresh()
        final = self.record["rounds"][-1] if self.record["rounds"] else []
        self.record["summary"] = {
            "changed": sum(1 for r in self.record["rounds"] for a in r if a["status"] == "done"),
            "errors": sum(1 for a in final if a["status"] == "error"),
            "installed": sum(1 for r in self.record["rounds"] for a in r if a["status"] == "done" and a["action"] in ("install", "update")),
            "uninstalled": sum(1 for r in self.record["rounds"] for a in r if a["status"] == "done" and a["action"] == "uninstall"),
            "app": self.record["app"], "waiting": [public([a])[0] for a in final if a["status"] in ("manual", "blocked", "declined")]}
        self.record["outcome"] = ("error" if self.record["summary"]["errors"] else
                                  "waiting" if self.record["summary"]["waiting"] else "ok")

    def _revert(self):
        source = load_run(self.record["tv"], self.revert_run)
        self.record["reverts"] = self.revert_run
        acts = revert_plan(self.ctx, source)
        self._round(acts)
        kept = []
        if self.keep_reverted:  # so the next apply does not disable them again
            for a in acts:
                if a["status"] == "done" and a["action"] == "enable":
                    set_app_decision(self.record["tv"], a["target"], "keep")
                    kept.append(a["target"])
        self.record["summary"] = {
            "changed": sum(1 for a in acts if a["status"] == "done"),
            "errors": sum(1 for a in acts if a["status"] == "error"),
            "reinstall": [a["target"] for a in acts if a["action"] == "reinstall"],
            "kept": kept, "reverts": self.revert_run}
        self.record["outcome"] = "error" if self.record["summary"]["errors"] else "ok"

    def _restore(self):
        acts = restore_defaults_plan(self.ctx)
        self._round(acts)
        self.record["summary"] = {"changed": sum(1 for a in acts if a["status"] == "done"),
                                  "errors": sum(1 for a in acts if a["status"] == "error"),
                                  "reinstall": restore_gone(self.ctx)}
        self.record["outcome"] = "error" if self.record["summary"]["errors"] else "ok"


class StopRun(Exception):
    pass


def restore_defaults_plan(ctx):
    """Back to the TV's own defaults: every package on, stock home, baseline screensaver/animations."""
    acts = []
    for pkg in sorted(p for p, i in ctx.pkgs.items() if not i["enabled"]):
        acts.append(action("restore", pkg, "enable", ctx.classifier.classify(pkg)[1],
                           fn=lambda p=pkg: pm(ctx, "enable", p), undo={"op": "disable", "pkg": pkg}))
    stock, stock_home = stock_launcher(ctx.presets)
    if stock_home and ctx.dev.home() != stock_home:
        acts.append(action("restore", stock_home, "set-home", "stock home",
                           fn=lambda: ctx.dev.sh(f"cmd package set-home-activity --user 0 {stock_home}"),
                           undo={"op": "home", "value": ctx.dev.home()}))
    baseline = state_dir(ctx.prof) / "baseline.json"
    settings = json.loads(baseline.read_text()).get("settings", {}) if baseline.exists() else {}
    defaults = {"screensaver_components": settings.get("screensaver_components"),
                **{k: settings.get(k) or "1.0" for k in ANIMATION_KEYS}}
    current = ctx.dev.tv_settings()
    for key, value in defaults.items():
        if value and current.get(key) != value:
            ns = "secure" if key.startswith("screensaver") else "global"
            acts.append(action("restore", key, "set", value,
                               fn=lambda ns=ns, k=key, v=value: ctx.dev.sh(f"settings put {ns} {k} {shlex.quote(v)}"),
                               undo={"op": "settings", "ns": ns, "values": {key: current.get(key)}}))
    return acts


def legacy_undo(ctx, a):
    """Best-effort inverse for actions recorded before runs stored their own undo."""
    stock, stock_home = stock_launcher(ctx.presets)
    what, target = a["action"], a["target"]
    if what == "disable":
        return {"op": "enable", "pkg": target}
    if what == "enable":
        return {"op": "disable", "pkg": target}
    if what == "uninstall":
        return {"op": "reinstall", "pkg": target}
    if what == "install":
        return {"op": "uninstall", "pkg": target}
    if what == "replace-stock":
        return {"op": "launcher", "enable": stock, "home": stock_home}
    if what == "allow":
        return {"op": "appop", "pkg": target, "name": ctx.quirks.get("autostart_appop", "APP_AUTO_START"),
                "value": "default"}
    return None  # settings/keymap: previous values were not recorded


def revert_plan(ctx, record):
    """Actions that undo everything a run changed, newest first. Uninstalled apps come back as manual steps."""
    acts, seen = [], set()
    done = [a for r in record.get("rounds", []) for a in r if a.get("status") == "done"]
    live, _ = live_tv(ctx.presets)
    for a in reversed(done):
        u = a.get("undo") or legacy_undo(ctx, a)
        if not u:
            acts.append(action("revert", a["target"], a["action"], "previous value was not recorded", status="skipped"))
            continue
        key = (u["op"], u.get("pkg") or u.get("ns") or a["target"])
        if key in seen:
            continue
        seen.add(key)
        op, pkg = u["op"], u.get("pkg")
        if op == "enable" and ctx.installed(pkg) and not ctx.enabled(pkg):
            acts.append(action("revert", pkg, "enable", f"undo: {a['action']} ({a['detail']})"[:200],
                               fn=lambda p=pkg: pm(ctx, "enable", p)))
        elif op == "disable" and ctx.installed(pkg) and ctx.enabled(pkg) and pkg not in live:
            acts.append(action("revert", pkg, "disable", f"undo: {a['action']}", fn=lambda p=pkg: pm(ctx, "disable", p)))
        elif op == "uninstall" and ctx.installed(pkg):
            acts.append(action("revert", pkg, "uninstall", f"undo: installed by that run", status="confirm",
                               fn=uninstall_fn(ctx, pkg)))
        elif op == "reinstall" and not ctx.installed(pkg):
            app = ctx.catalog.get(u.get("app") or "") or next((a for a in ctx.catalog.values() if a["package"] == pkg), None)
            if app and app["source"] == "apk":
                acts.append(action("revert", pkg, "install", f"reinstall {app['name']} from {app['file']}",
                                   fn=install_apk_fn(ctx, app)))
            else:
                acts.append(action("revert", pkg, "reinstall", "uninstalled by that run: reinstall it from the Play Store",
                                   status="manual"))
        elif op == "appop":
            acts.append(action("revert", pkg, "appop", f"{u['name']} → {u['value']}",
                               fn=lambda p=pkg, n=u["name"], v=u["value"]: ctx.dev.sh(f"appops set {p} {n} {v}")))
        elif op == "keymap":
            app = keymap_app(ctx)
            if app and ctx.installed(app["package"]):
                acts.append(action("revert", app["package"], "push", f"previous key map: {u['value'] or '(empty)'}",
                                   fn=lambda v=u["value"] or "": push_keymap(ctx, v)))
        elif op == "launcher":
            def fn(u=u):
                for p in u.get("enable", []):
                    if ctx.installed(p) and not ctx.enabled(p):
                        pm(ctx, "enable", p)
                if u.get("home"):
                    ctx.dev.sh(f"cmd package set-home-activity --user 0 {u['home']}")
            acts.append(action("revert", u.get("home") or "home", "restore-home",
                               f"re-enable {', '.join(u.get('enable', []))}; home → {u.get('home')}", fn=fn))
        elif op == "home" and u.get("value"):
            acts.append(action("revert", u["value"], "set-home", "previous home",
                               fn=lambda v=u["value"]: ctx.dev.sh(f"cmd package set-home-activity --user 0 {v}")))
        elif op == "settings":
            def fn(u=u):
                for k, v in u["values"].items():
                    ctx.dev.sh(f"settings delete {u['ns']} {k}" if v is None else
                               f"settings put {u['ns']} {k} {shlex.quote(str(v))}")
            acts.append(action("revert", u["ns"], "settings", ", ".join(f"{k}={v}" for k, v in u["values"].items()),
                               fn=fn))
    return acts


def catalog_app_for(ctx, ref):
    """Catalog id or package -> (app_id, app) or (None, None)."""
    if ref in ctx.catalog:
        return ref, ctx.catalog[ref]
    for app_id, app in ctx.catalog.items():
        if app["package"] == ref:
            return app_id, app
    return None, None


def app_roles(ctx, pkg):
    """Why an app must not be uninstalled from the store, if it plays a role in the profile."""
    home = ctx.prof["home"]
    roles = []
    for role, key in (("home screen", "launcher"), ("screensaver", "screensaver")):
        ref = home.get(key)
        if ref and ref != "stock" and ref in ctx.catalog and ctx.catalog[ref]["package"] == pkg:
            roles.append(role)
    km = keymap_app(ctx)
    if km and km["package"] == pkg and ctx.prof["keys"]:
        roles.append("remote buttons")
    return roles


def store_view(ctx):
    """Catalog apps (installable) and other user apps (removable) on this TV."""
    tracked = set(ctx.install_ids())
    apps = []
    for app_id, app in ctx.catalog.items():
        if app["source"] == "system":
            continue
        pkg = app["package"]
        installed = ctx.installed(pkg)
        apps.append({"id": app_id, "name": app["name"], "package": pkg, "source": app["source"],
                     "note": app.get("note", ""), "catalog_version": app.get("version"),
                     "installed": installed, "enabled": ctx.enabled(pkg),
                     "version": ctx.dev.version(pkg) if installed else None,
                     "in_profile": app_id in tracked, "needs_a11y": bool(app.get("a11y")),
                     "roles": app_roles(ctx, pkg),
                     "blocked": app["source"] == "play" and not ctx.installed("com.android.vending")})
    known = {a["package"] for a in ctx.catalog.values()}
    others = [{"package": p, "note": ctx.classifier.classify(p)[1]} for p, i in sorted(ctx.pkgs.items())
              if i["user"] and p not in known]
    return {"apps": apps, "others": others, "debloat": ctx.prof["apps"].get("debloat", True),
            "launcher": ctx.prof["home"].get("launcher")}


def track_app(profile, app_id, add):
    """Add/remove a catalog app in [apps].install so the workflow keeps (or stops) installing it."""
    prof = load_profile(profile)
    current = list(prof["apps"].get("install", []))
    values = current + [app_id] if add and app_id not in current else [a for a in current if a != app_id]
    if values != current:
        text = set_toml_array(prof["_path"].read_text(), "apps", "install", values)
        tomllib.loads(text)
        prof["_path"].write_text(text)


def load_run(name, run_id):
    if not re.fullmatch(r"\d{8}-\d{6}", run_id):
        raise TvError("bad run id")
    path = STATE_DIR / name / "runs" / f"{run_id}.json"
    if not path.exists():
        raise TvError(f"no run {run_id} for {name}")
    return json.loads(path.read_text())


def restore_gone(ctx):
    baseline = state_dir(ctx.prof) / "baseline.json"
    if not baseline.exists():
        return []
    before = json.loads(baseline.read_text())["packages"]
    return sorted(p for p, i in before.items() if i["user"] and p not in ctx.pkgs)


class CliHooks(Hooks):
    """Terminal driver: prints progress, asks on the TTY, mirrors events to the dashboard if it runs."""
    def __init__(self, args):
        self.args = args
        self.interactive = sys.stdin.isatty() and not args.json
        self.ui = UiClient()

    def emit(self, event):
        self.ui.send(event)
        if self.args.json:
            return
        t = event["type"]
        if t == "phase" and event["status"] != "done":
            print(f"» {event['name']} {event['status']}" + (f": {event.get('detail')}" if event.get("detail") else ""))
        elif t == "round" and not event["execute"]:
            print_actions(event["actions"])
        elif t == "action" and event["status"] not in ("running",):
            print_actions([event])
        elif t == "perf":
            d = event["data"]
            print(f"  RAM available {d['mem_available_mb']} MB of {d['mem_total_mb']} MB, "
                  f"swap used {d['swap_used_mb']} MB, load {d['load1']}")

    def confirm(self, actions):
        if not self.interactive:
            return set()
        return {i for i, a in enumerate(actions) if confirm(f"  {a['action']} {a['target']} – {a['detail']}?")}

    def wait(self, waiting):
        if not self.interactive or getattr(self.args, "no_wait", False):
            return False
        print("\nOn the TV:")
        for a in waiting:
            print(f"  • {a['detail']}")
        input("Press Enter when done to re-check (Ctrl-C to stop)… ")
        return True


def cmd_apply(args):
    ensure_ui()
    wf = Workflow(args.profile, "apply", CliHooks(args), yes=args.yes, reboot=args.reboot,
                  measure=args.measure, source="cli", steps=parse_steps(args.only, args.skip, args.recipe))
    rec = wf.run()
    if rec["outcome"] == "error" and rec.get("error"):
        raise TvError(rec["error"])
    final = rec["rounds"][-1] if rec["rounds"] else []
    errors = [a for a in final if a["status"] == "error"]
    waiting = [a for a in final if a["status"] in ("manual", "blocked", "declined")]
    if args.json:
        print(json.dumps({"tv": rec["tv"], "run": rec["id"], "outcome": rec["outcome"],
                          "rounds": [public(r) for r in rec["rounds"]], "waiting_on_owner": public(waiting),
                          "errors": public(errors), "perf_before": rec["perf_before"], "perf_after": rec["perf_after"]},
                         indent=1))
    elif rec["outcome"] == "ok":
        print("✓ TV matches the profile")
