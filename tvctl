def init_tv(name, host, port=5555, force=False, wait=120):
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]{1,40}", name):
        raise TvError("name: lowercase letters, digits and dashes, e.g. kitchen-sony")
    path = PROFILES_DIR / f"{name}.toml"
    if path.exists() and not force:
        raise TvError(f"{path.name} exists (use --force to overwrite)")
    dev = Device(host, port)
    dev.connect(wait=wait)
    props = dev.props()
    pkgs = dev.packages()
    presets = detect_presets(props, pkgs)
    model = f"{props.get('ro.product.manufacturer')} {props.get('ro.product.model')} ({props.get('ro.product.name')}), " \
            f"Android {props.get('ro.build.version.release')}"
    PROFILES_DIR.mkdir(exist_ok=True)
    path.write_text(PROFILE_TEMPLATE.format(
        name=name, date=datetime.now().date(), host=host, port=port,
        serial=props.get("ro.serialno", ""), model=model, presets=json.dumps(presets)))
    prof = load_profile(name)
    baseline = state_dir(prof) / "baseline.json"
    if not baseline.exists():
        take_snapshot(dev, prof, "baseline.json")
    ctx = Ctx(prof, dev)
    dossier = discover(ctx)
    load_guide(ctx, rebuild=True)
    counts = {}
    for pkg in pkgs:
        cls = ctx.classifier.classify(pkg)[0]
        if pkgs[pkg]["user"] and cls == "unknown":
            cls = "user"
        counts[cls] = counts.get(cls, 0) + 1
    return {"profile": str(path.relative_to(ROOT)), "name": name, "model": model, "presets": presets,
            "notes": dossier["notes"],
            "package_classes": counts, "baseline": str(baseline.relative_to(ROOT))}


def cmd_init(args):
    ensure_ui()
    data = init_tv(args.name, args.host, args.port, args.force)
    def human():
        print(f"✓ {data['model']}")
        print(f"  presets detected: {', '.join(data['presets']) or 'none – this brand is new, see prompts/classify-packages.md'}")
        print(f"  packages: " + ", ".join(f"{k} {v}" for k, v in sorted(data['package_classes'].items())))
        print(f"  wrote {data['profile']}, baseline {data['baseline']}")
        print(f"\nNext: review `tvctl inventory {args.name} --class unknown` and `--class optional`, "
              f"fill in the profile with the owner, then `tvctl plan {args.name}`.")
    emit(args, data, human)
    return EXIT_OK


