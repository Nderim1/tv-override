            if target:
                label = input(f"  Label [{labels.get(scan, '')}]: ").strip() or labels.get(scan, f"key {scan}")
                keys[scan] = {"label": label, "open": ctx.resolve_pkg(target)}
                write_keys(ctx.prof, keys)
            if not confirm("Remap another button?"):
                break
        args.keys_cmd = "push"
        ctx.prof = load_profile(args.profile)

    if args.keys_cmd == "set":
        if args.scan in PROTECTED_KEYS:
            raise TvError(f"{PROTECTED_KEYS[args.scan]} is needed to use the TV and cannot be remapped")
        entry = {"label": args.label or labels.get(args.scan, f"key {args.scan}")}
        if args.open:
            entry["open"] = ctx.resolve_pkg(args.open)
        elif args.action and args.package:
            entry["action"], entry["package"] = args.action, ctx.resolve_pkg(args.package)
        else:
            raise TvError("use --open PKG, or --action ACTION --package PKG")
        keys[args.scan] = entry
        write_keys(ctx.prof, keys)
        ctx.prof = load_profile(args.profile)
        print(f"profile: {args.scan} -> {entry}")
        args.keys_cmd = "push"

    if args.keys_cmd == "rm":
        keys.pop(args.scan, None)
        write_keys(ctx.prof, keys)
        ctx.prof = load_profile(args.profile)
        args.keys_cmd = "push"

    if args.keys_cmd == "push":
        app = keymap_app(ctx)
        if not app or not ctx.installed(app["package"]):
            raise TvError("Remote Remap is not installed – add remote-remap to [apps].install and run apply")
        raw = keymap_string(ctx)
        push_keymap(ctx, raw)
        emit(args, {"keymap": raw}, lambda: print(f"✓ pushed to TV: {raw or '(empty)'}"))
    return EXIT_OK


# ---- find / init

def local_networks():
    nets = {"192.168.0.0/24", "192.168.1.0/24"}
    _, out, _ = run(["ifconfig"], timeout=10) if shutil.which("ifconfig") else (0, "", "")
    for m in re.finditer(r"inet (\d+\.\d+\.\d+)\.\d+ ", out):
        if not m.group(1).startswith("127."):
            nets.add(f"{m.group(1)}.0/24")
    return sorted(nets)


def probe(host, ports, timeout=0.5):
    open_ = []
    for port in ports:
        try:
            with socket.create_connection((host, port), timeout=timeout):
                open_.append(port)
        except OSError:
            pass
    return host, open_


def cast_name(host):
    try:
        with urllib.request.urlopen(f"http://{host}:8008/setup/eureka_info?params=name", timeout=1.5) as r:
            return json.loads(r.read()).get("name")
    except Exception:
        return None


def find_tvs(cidrs=None):
    ports = [5555, 6466, 8008, 8060]
    nets = cidrs or local_networks()
    hosts = [str(h) for net in nets for h in ip_network(net, strict=False).hosts()]
    with ThreadPoolExecutor(max_workers=256) as pool:
        results = [r for r in pool.map(lambda h: probe(h, ports), hosts) if r[1]]
    found = []
    for host, open_ in results:
        kind = ("Roku – not supported (no ADB)" if 8060 in open_ else
                "Android/Google TV" if {6466, 8008} & set(open_) else "ADB device")
        found.append({"host": host, "ports": open_, "kind": kind, "adb_enabled": 5555 in open_,
                      "name": cast_name(host) if 8008 in open_ else None})
    return nets, found


def cmd_find(args):
    if not args.json:
        print(f"Scanning {', '.join(args.cidr or local_networks())}…", file=sys.stderr)
    _, found = find_tvs(args.cidr)
    def human():
        if not found:
            print("No TVs found. Is the TV on and on a network this computer can reach?")
        for f in found:
            print(f"  {f['host']:<16} {f['kind']:<32} {f['name'] or '':<24} "
                  f"{'ADB on' if f['adb_enabled'] else 'ADB off: enable Developer options > USB debugging'}")
    emit(args, found, human)
    return EXIT_OK


PROFILE_TEMPLATE = """# {name} – created by `tvctl init` on {date}. Fill in with the owner (see prompts/owner-interview.md).

[tv]
name = "{name}"
host = "{host}"
port = {port}
serial = "{serial}"    # tvctl refuses to apply this profile to another TV
model = "{model}"
presets = {presets}  # core + streaming-apps are always loaded

[apps]
# Catalog ids from apps.toml to install, e.g. ["projectivy", "smarttube", "kodi"]
install = []
# Packages never disabled/uninstalled (e.g. voice search, AirPlay the owner uses)
keep = []
# Optional packages the owner does not want (bloat from presets is disabled automatically)
disable = []
# "keep-others" leaves other user-installed apps alone; "remove-others" uninstalls them (asks first)
user_apps = "keep-others"

[home]
# launcher = "projectivy"      # catalog id, or "stock"
# screensaver = "aerialviews"  # catalog id with a `dream`
# animation_scale = 0.5

[keys]
"""


def init_tv(name, host, port=5555, force=False, wait=120):
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]{1,40}", name):
        raise TvError("name: lowercase letters, digits and dashes, e.g. kitchen-sony")
    path = PROFILES_DIR / f"{name}.toml"
    if path.exists() and not force:
        raise TvError(f"{path.name} exists (use --force to overwrite)")
    dev = Device(host, port)
    dev.connect(wait=wait)
    props = dev.props()
    pkgs = dev.packages()
    presets = detect_presets(props, pkgs)
    model = f"{props.get('ro.product.manufacturer')} {props.get('ro.product.model')} ({props.get('ro.product.name')}), " \
            f"Android {props.get('ro.build.version.release')}"
    PROFILES_DIR.mkdir(exist_ok=True)
    path.write_text(PROFILE_TEMPLATE.format(
        name=name, date=datetime.now().date(), host=host, port=port,
        serial=props.get("ro.serialno", ""), model=model, presets=json.dumps(presets)))
    prof = load_profile(name)
    baseline = state_dir(prof) / "baseline.json"
    if not baseline.exists():
        take_snapshot(dev, prof, "baseline.json")
    ctx = Ctx(prof, dev)
    counts = {}
    for pkg in pkgs:
        cls = ctx.classifier.classify(pkg)[0]
        if pkgs[pkg]["user"] and cls == "unknown":
            cls = "user"
        counts[cls] = counts.get(cls, 0) + 1
    return {"profile": str(path.relative_to(ROOT)), "name": name, "model": model, "presets": presets,
            "package_classes": counts, "baseline": str(baseline.relative_to(ROOT))}


def cmd_init(args):
    ensure_ui()
    data = init_tv(args.name, args.host, args.port, args.force)
    def human():
        print(f"✓ {data['model']}")
        print(f"  presets detected: {', '.join(data['presets']) or 'none – this brand is new, see prompts/classify-packages.md'}")
        print(f"  packages: " + ", ".join(f"{k} {v}" for k, v in sorted(data['package_classes'].items())))
        print(f"  wrote {data['profile']}, baseline {data['baseline']}")
        print(f"\nNext: review `tvctl inventory {args.name} --class unknown` and `--class optional`, "
              f"fill in the profile with the owner, then `tvctl plan {args.name}`.")
    emit(args, data, human)
    return EXIT_OK


# ---------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser(prog="tvctl", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    sub = ap.add_subparsers(dest="cmd", required=True)

    def add(name, fn, help_, profile=True):
        p = sub.add_parser(name, help=help_)
        p.add_argument("--json", action="store_true", default=argparse.SUPPRESS)
        if profile:
            p.add_argument("profile")
        p.set_defaults(fn=fn)
        return p

    p = add("find", cmd_find, "find TVs on the network", profile=False)
    p.add_argument("--cidr", action="append", help="network to scan, e.g. 192.168.1.0/24 (repeatable)")
    p = add("init", cmd_init, "connect a new TV and write its profile", profile=False)
    p.add_argument("name")
    p.add_argument("--host", required=True)
    p.add_argument("--port", type=int, default=5555)
    p.add_argument("--force", action="store_true")
    p = add("inventory", cmd_inventory, "list packages with their classification")
    p.add_argument("--class", dest="cls", choices=["core", "bloat", "optional", "unknown", "user"])
    p.add_argument("--mem", action="store_true", help="include RAM use (slow)")
    add("plan", cmd_plan, "show what apply would change")
    p = add("apply", cmd_apply, "make the TV match the profile")
    p.add_argument("--yes", action="store_true", help="confirm uninstalls without asking")
    p.add_argument("--no-wait", action="store_true", help="don't wait for manual steps")
    p.add_argument("--reboot", action="store_true", help="reboot after changes and verify")
    p.add_argument("--measure", action="store_true", help="measure performance before and after")
    p = add("restore", cmd_restore, "re-enable disabled packages")
    p.add_argument("packages", nargs="*")
    p.add_argument("--all", action="store_true", help="re-enable every disabled package")
    p.add_argument("--defaults", action="store_true", help="back to the TV's defaults: packages, home, settings")
    p = add("revert", cmd_revert, "undo what one run changed")
    p.add_argument("run", help="run id from state/<tv>/runs (e.g. 20261020-111623)")
    p.add_argument("--keep", action="store_true", help="add re-enabled packages to [apps].keep")
    p.add_argument("--yes", action="store_true", help="confirm uninstalls of apps that run installed")
    p.add_argument("--measure", action="store_true")
    p = add("install", cmd_install, "install one catalog app")
    p.add_argument("app_id")
    p.add_argument("--force", action="store_true")
    p = add("status", cmd_status, "show TV state")
    p.add_argument("--reboot", action="store_true", help="reboot first and check the TV boots into the profile")
    add("snapshot", cmd_snapshot, "save the current package state")
    p = add("ask", cmd_ask, "ask the owner in the dashboard and wait for the answer", profile=False)
    p.add_argument("--title", required=True)
    p.add_argument("--body")
    p.add_argument("--kind", choices=["choice", "multi", "confirm", "text", "action"], default="choice")
    p.add_argument("--tv", help="profile name the question is about")
    p.add_argument("--option", action="append", metavar="VALUE=LABEL|HINT")
    p.add_argument("--options-json", metavar="FILE", help="JSON list of {value,label,hint,checked}; - for stdin")
    p.add_argument("--options-from", choices=["optional", "bloat", "user"], help="options from the TV's packages")
    p.add_argument("--checked", action="append", help="option value to pre-check")
    p.add_argument("--timeout", type=int, default=540, help="seconds to wait (default 540)")
    p.add_argument("--no-open", action="store_true", help="don't open the browser")
    p = add("inbox", cmd_inbox, "pick up the owner's requests from the dashboard", profile=False)
    p.add_argument("--wait", type=int, default=0, help="seconds to wait for a request")
    p.add_argument("--reply", nargs=2, metavar=("ID", "TEXT"))
    p.add_argument("--done", action="store_true", help="with --reply: mark the request done")
    p = add("notify", cmd_notify, "post a note to the dashboard", profile=False)
    p.add_argument("--title", required=True)
    p.add_argument("--body")
    p.add_argument("--level", choices=["info", "warn", "need-chat", "done"], default="info")
    p.add_argument("--tv")
    p = add("ui", cmd_ui, "run the dashboard (control center)", profile=False)
    p.add_argument("--port", type=int, default=UI_PORT)
    p.add_argument("--no-open", action="store_true", help="don't open the browser")

    p = sub.add_parser("keys", help="remote button remapping")
    ksub = p.add_subparsers(dest="keys_cmd", required=True)
    for name, help_ in (("capture", "show scan codes of pressed buttons"), ("learn", "interactive remap"),
                        ("set", "map a button"), ("rm", "unmap a button"), ("push", "send the mapping to the TV")):
        kp = ksub.add_parser(name, help=help_)
        kp.add_argument("--json", action="store_true", default=argparse.SUPPRESS)
        kp.add_argument("profile")
        kp.set_defaults(fn=cmd_keys)
        if name == "capture":
            kp.add_argument("--seconds", type=int, default=20)
        if name in ("set", "rm"):
            kp.add_argument("scan", type=int)
        if name == "set":
            kp.add_argument("--open", help="catalog id or package to launch")
            kp.add_argument("--action", help="intent action to send (with --package)")
            kp.add_argument("--package")
            kp.add_argument("--label")

    args = ap.parse_args()
    try:
        sys.exit(args.fn(args))
    except TvError as e:
        if args.json:
            print(json.dumps({"error": str(e)}))
        else:
            print(f"error: {e}", file=sys.stderr)
        sys.exit(EXIT_ERR)
    except KeyboardInterrupt:
        sys.exit(EXIT_USER)


if __name__ == "__main__":
    main()
