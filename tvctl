#!/usr/bin/env python3
"""tvctl – profile-driven setup of Android / Google TVs over ADB.

  tvctl find                              find TVs on the network
  tvctl init NAME --host IP               connect, detect, snapshot, write profiles/NAME.toml
  tvctl inventory PROFILE [--class unknown] [--mem]
  tvctl plan PROFILE                      what apply would change
  tvctl apply PROFILE [--yes]             make the TV match the profile (safe to re-run)
        [--recipe full|apps-only|cleanup|home-screen] [--only apps,debloat,home,screensaver,tweaks,buttons]
  tvctl restore PROFILE [PKG...|--all]    re-enable disabled packages, restore stock home
  tvctl revert PROFILE RUN_ID [--keep]    undo what one run changed
  tvctl install PROFILE APP [--force]     install one catalog app on its own (no debloat needed)
  tvctl uninstall PROFILE APP [--yes]     uninstall one app
  tvctl keys capture|learn|set|rm|push PROFILE ...
  tvctl status PROFILE [--reboot]
  tvctl ui                                dashboard at http://127.0.0.1:8787 (auto-started by workflows)
  tvctl ask --title Q [--kind ...]        ask the owner in the dashboard, print the answer (agent use)
  tvctl inbox [--wait N]                  the owner's requests to the agent; --reply ID TEXT [--done]
  tvctl notify --title T [--level ...]    post a note; --level need-chat = "come to the chat"
  tvctl helper ROLE --tv TV "QUESTION"    read-only helper agent (same model, lowest effort; agent.toml)
  tvctl screenshot PROFILE [--out F]      PNG of what the TV shows (for the agent to look at)
  tvctl discover PROFILE                  read all TV data (state/<tv>/dossier.json)
  tvctl guide show|set|verify|done|skip|auto PROFILE ...   preparation walkthrough for this TV
  tvctl snapshot PROFILE

Add --json to any command for machine-readable output (used by the LLM agent).
Exit codes: 0 ok, 1 error, 2 waiting on the owner (manual step or confirmation).
"""

