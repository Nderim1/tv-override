def cmd_restore(args):
    ctx = ctx_for(args)
    if args.defaults:
        ensure_ui()
        rec = Workflow(args.profile, "restore", CliHooks(args), measure=False).run()
        if args.json:
            print(json.dumps({"outcome": rec["outcome"], "actions": public(rec["rounds"][-1] if rec["rounds"] else []),
                              "reinstall": rec["summary"].get("reinstall", [])}, indent=1))
        elif rec["summary"].get("reinstall"):
            print("\nUninstalled since baseline (reinstall from the Play Store if wanted):\n  "
                  + "\n  ".join(rec["summary"]["reinstall"]))
        print("Note: the next `tvctl apply` applies the profile again.", file=sys.stderr)
        return EXIT_ERR if rec["outcome"] == "error" else EXIT_OK
    stock, stock_home = stock_launcher(ctx.presets)
    targets = args.packages or ([p for p, i in ctx.pkgs.items() if not i["enabled"]] if args.all else [])
    if not targets:
        raise TvError("name packages to re-enable, or use --all / --defaults")
    acts = []
    for pkg in targets:
        if not ctx.installed(pkg):
            acts.append(action("restore", pkg, "enable", "not installed", status="skipped"))
            continue
        try:
            pm(ctx, "enable", pkg)
            acts.append(action("restore", pkg, "enable", status="done"))
        except TvError as e:
            acts.append(action("restore", pkg, "enable", str(e), status="error"))
    if stock_home and any(p in targets for p in stock):
        ctx.dev.sh(f"cmd package set-home-activity --user 0 {stock_home}")
        acts.append(action("restore", stock_home, "set-home", "stock home", status="done"))
    ctx.refresh()
    gone = restore_gone(ctx)
    log_history(ctx.prof, acts)
    emit(args, {"actions": public(acts), "uninstalled_since_baseline": gone}, lambda: (
        print_actions(acts),
        gone and print("\nUninstalled since baseline (reinstall from the Play Store if wanted):\n  " + "\n  ".join(gone))))
    print("Note: restored packages may be disabled again by the next `tvctl apply` unless the profile changes.",
          file=sys.stderr)
