def remote_labels(ctx):
    return {int(k): v for k, v in merged(ctx.presets, "remote_keys").items()}


def capture_keys(dev, seconds, first_only=False):
    """Yield {"scan": int, "device": name, "time": float} for each key-down within `seconds`."""
    # -tt: a pty makes getevent line-buffered, so presses arrive as they happen
    proc = subprocess.Popen([dev.adb_bin, "-s", dev.addr, "shell", "-tt", f"timeout {seconds} getevent -t"],
                            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    names, current = {}, None
    try:
        for line in proc.stdout:
            line = line.strip()
            m = re.match(r"add device \d+: (\S+)", line)
            if m:
                current = m.group(1)
                continue
            m = re.match(r'name:\s+"(.*)"', line)
            if m and current:
                names[current] = m.group(1)
                continue
            m = re.match(r"\[\s*([\d.]+)\] (\S+): 0001 ([0-9a-f]{4}) 00000001", line)
            if m:
                yield {"scan": int(m.group(3), 16), "device": names.get(m.group(2), m.group(2)),
                       "time": float(m.group(1))}
                if first_only:
                    break
    finally:
        proc.kill()


def write_keys(prof, keys):
    """Rewrite only the [keys] section of the profile, keeping everything else (and comments) as is."""
    path = prof["_path"]
    text = path.read_text()
    lines = [f"[keys]"]
    for scan, k in sorted(keys.items(), key=lambda kv: int(kv[0])):
        fields = ", ".join(f"{f} = {json.dumps(k[f])}" for f in ("label", "open", "action", "package") if f in k)
        lines.append(f"{int(scan)} = {{ {fields} }}")
    block = "\n".join(lines) + "\n"
    m = re.search(r"^\[keys\]\n(?:(?!^\[).*\n?)*", text, re.M)
    text = text[:m.start()] + block + text[m.end():] if m else text.rstrip("\n") + "\n\n" + block
    path.write_text(text)


# Keys that keep the TV usable: navigation, volume, power, and everything live TV needs
# (channels, digits, guide, info, teletext/colour keys, audio/subtitles, last channel).
PROTECTED_KEYS = {103: "Up", 108: "Down", 105: "Left", 106: "Right", 28: "Enter", 352: "OK", 353: "OK",
                  158: "Back", 102: "Home", 172: "Home", 114: "Volume down", 115: "Volume up", 113: "Mute",
                  116: "Power", 142: "Sleep",
                  402: "Channel up", 403: "Channel down", 405: "Last channel", 365: "Guide", 358: "Info",
                  377: "TV", 388: "Teletext", 392: "Audio track", 370: "Subtitles",
                  398: "Red", 399: "Green", 400: "Yellow", 401: "Blue",
                  11: "0", **{n + 1: str(n) for n in range(1, 10)},
                  **{512 + n: str(n) for n in range(10)}}


def launch_targets(ctx):
    """Apps (and catalog intent actions) a remote button can open on this TV."""
    out = ctx.dev.sh("cmd package query-activities --brief -a android.intent.action.MAIN "
                     "-c android.intent.category.LEANBACK_LAUNCHER; echo ---; "
                     "cmd package query-activities --brief -a android.intent.action.MAIN "
                     "-c android.intent.category.LAUNCHER")
    pkgs = sorted({l.strip().split("/")[0] for l in out.splitlines() if "/" in l})
    names = {a["package"]: a["name"] for a in ctx.catalog.values()}
    targets = []
    for pkg in pkgs:
        if ctx.enabled(pkg) and pkg != "com.nde.tvremap":
            note = ctx.classifier.classify(pkg)[1]
            targets.append({"type": "app", "package": pkg, "label": names.get(pkg) or note or pkg})
    for app in ctx.catalog.values():
        if ctx.enabled(app["package"]):
            for act, label in app.get("actions", {}).items():
                targets.append({"type": "action", "package": app["package"], "action": act,
                                "label": f"{app['name']}: {label}"})
    return sorted(targets, key=lambda t: (t["type"] != "app", t["label"].lower()))


def set_key(profile, scan, entry):
    """Map (entry dict) or unmap (entry None) a button in the profile, then push to the TV if possible."""
    scan = int(scan)
    if scan in PROTECTED_KEYS:
        raise TvError(f"{PROTECTED_KEYS[scan]} is needed to use the TV and cannot be remapped")
    prof = load_profile(profile)
    keys = {int(k): v for k, v in prof["keys"].items()}
    if entry is None:
        keys.pop(scan, None)
    else:
        if not re.fullmatch(r"[A-Za-z0-9_.]+", entry.get("open") or entry.get("package") or ""):
            raise TvError("bad package name")
        if "action" in entry and not re.fullmatch(r"[A-Za-z0-9_.]+", entry["action"]):
            raise TvError("bad intent action")
        keys[scan] = {k: v for k, v in entry.items() if k in ("label", "open", "action", "package") and v}
    write_keys(prof, keys)
    return keys


def remap_status(ctx):
    app = keymap_app(ctx)
    if not app:
        return {"in_profile": False}
    pkg = app["package"]
    st = {"in_profile": True, "installed": ctx.installed(pkg), "enabled": app["a11y"] in ctx.dev.a11y_enabled(),
          "running": ctx.dev.running(pkg), "keymap": None}
    if st["installed"]:
        st["keymap"] = ctx.dev.broadcast(REMAP_RECEIVER, "com.nde.tvremap.GET_KEYMAP")[1]
    return st


def try_target(ctx, entry):
    """Open a key's target on the TV right now, like pressing the button would."""
    if entry.get("action"):
        ctx.dev.sh(f"am start -a {shlex.quote(entry['action'])}")
    else:
        pkg = ctx.resolve_pkg(entry["open"])
        out = ctx.dev.sh(f"monkey -p {shlex.quote(pkg)} -c android.intent.category.LEANBACK_LAUNCHER 1 2>&1")
        if "No activities found" in out:
            ctx.dev.sh(f"monkey -p {shlex.quote(pkg)} -c android.intent.category.LAUNCHER 1")


def cmd_keys(args):
    ctx = ctx_for(args)
    labels = remote_labels(ctx)
    keys = {int(k): v for k, v in ctx.prof["keys"].items()}

    if args.keys_cmd == "capture":
        if not args.json:
            print(f"Listening for {args.seconds}s – press buttons on the remote now.", file=sys.stderr)
        presses = []
        for p in capture_keys(ctx.dev, args.seconds):
            p["label"] = labels.get(p["scan"], "")
            p["mapped"] = keys.get(p["scan"])
            presses.append(p)
            if not args.json:
                print(f"  scan {p['scan']:>4}  {p['label'] or '?':<10} {p['device']}"
                      + (f"  (mapped: {p['mapped']})" if p["mapped"] else ""))
        if args.json:
            print(json.dumps(presses, indent=1))
        return EXIT_OK

    if args.keys_cmd == "learn":
        while True:
            print("Press the remote button to remap (20s)…")
            press = next(capture_keys(ctx.dev, 20, first_only=True), None)
            if not press:
                print("no button press seen")
                return EXIT_USER
            scan = press["scan"]
            print(f"  got scan {scan} ({labels.get(scan, 'unknown button')}, {press['device']})")
            target = input("  Open which app? catalog id or package (blank = skip): ").strip()
            if target:
                label = input(f"  Label [{labels.get(scan, '')}]: ").strip() or labels.get(scan, f"key {scan}")
                keys[scan] = {"label": label, "open": ctx.resolve_pkg(target)}
                write_keys(ctx.prof, keys)
            if not confirm("Remap another button?"):
                break
        args.keys_cmd = "push"
        ctx.prof = load_profile(args.profile)

    if args.keys_cmd == "set":
        if args.scan in PROTECTED_KEYS:
            raise TvError(f"{PROTECTED_KEYS[args.scan]} is needed to use the TV and cannot be remapped")
        entry = {"label": args.label or labels.get(args.scan, f"key {args.scan}")}
        if args.open:
            entry["open"] = ctx.resolve_pkg(args.open)
        elif args.action and args.package:
            entry["action"], entry["package"] = args.action, ctx.resolve_pkg(args.package)
        else:
            raise TvError("use --open PKG, or --action ACTION --package PKG")
        keys[args.scan] = entry
        write_keys(ctx.prof, keys)
        ctx.prof = load_profile(args.profile)
        print(f"profile: {args.scan} -> {entry}")
        args.keys_cmd = "push"

    if args.keys_cmd == "rm":
        keys.pop(args.scan, None)
        write_keys(ctx.prof, keys)
        ctx.prof = load_profile(args.profile)
        args.keys_cmd = "push"

    if args.keys_cmd == "push":
        app = keymap_app(ctx)
        if not app or not ctx.installed(app["package"]):
            raise TvError("Remote Remap is not installed – add remote-remap to [apps].install and run apply")
        raw = keymap_string(ctx)
        push_keymap(ctx, raw)
        emit(args, {"keymap": raw}, lambda: print(f"✓ pushed to TV: {raw or '(empty)'}"))
    return EXIT_OK


# ---- find / init

def local_networks():
    nets = {"192.168.0.0/24", "192.168.1.0/24"}
    _, out, _ = run(["ifconfig"], timeout=10) if shutil.which("ifconfig") else (0, "", "")
    for m in re.finditer(r"inet (\d+\.\d+\.\d+)\.\d+ ", out):
        if not m.group(1).startswith("127."):
            nets.add(f"{m.group(1)}.0/24")
    return sorted(nets)


def probe(host, ports, timeout=0.5):
    open_ = []
    for port in ports:
        try:
            with socket.create_connection((host, port), timeout=timeout):
                open_.append(port)
        except OSError:
            pass
    return host, open_


def cast_name(host):
    try:
        with urllib.request.urlopen(f"http://{host}:8008/setup/eureka_info?params=name", timeout=1.5) as r:
            return json.loads(r.read()).get("name")
    except Exception:
        return None


def find_tvs(cidrs=None):
    ports = [5555, 6466, 8008, 8060]
    nets = cidrs or local_networks()
    hosts = [str(h) for net in nets for h in ip_network(net, strict=False).hosts()]
    with ThreadPoolExecutor(max_workers=256) as pool:
        results = [r for r in pool.map(lambda h: probe(h, ports), hosts) if r[1]]
    found = []
    for host, open_ in results:
        kind = ("Roku – not supported (no ADB)" if 8060 in open_ else
                "Android/Google TV" if {6466, 8008} & set(open_) else "ADB device")
        found.append({"host": host, "ports": open_, "kind": kind, "adb_enabled": 5555 in open_,
                      "name": cast_name(host) if 8008 in open_ else None})
    return nets, found


def cmd_find(args):
    if not args.json:
        print(f"Scanning {', '.join(args.cidr or local_networks())}…", file=sys.stderr)
    _, found = find_tvs(args.cidr)
    def human():
        if not found:
            print("No TVs found. Is the TV on and on a network this computer can reach?")
        for f in found:
            print(f"  {f['host']:<16} {f['kind']:<32} {f['name'] or '':<24} "
                  f"{'ADB on' if f['adb_enabled'] else 'ADB off: enable Developer options > USB debugging'}")
    emit(args, found, human)
    return EXIT_OK


