# ---- profile editing (dashboard)

def set_toml_array(text, section, key, values):
    """Rewrite `key = [...]` inside [section], keeping per-item comments of entries that stay."""
    sec = re.search(rf"^\[{re.escape(section)}\]\n(?:(?!^\[).*\n?)*", text, re.M)
    if not sec:
        raise TvError(f"profile has no [{section}] section")
    body = sec.group(0)
    m = re.search(rf"^{key}\s*=\s*\[(.*?)\]", body, re.M | re.S)
    old_lines = {}  # keep "  "pkg",  # comment" lines for items that stay (one item per line only)
    if m:
        for line in m.group(1).splitlines():
            quoted = re.findall(r'"([^"]+)"', line.split("#", 1)[0])
            if len(quoted) == 1 and "#" in line:
                old_lines[quoted[0]] = f'"{quoted[0]}",  #' + line.split("#", 1)[1].rstrip()
    items = [old_lines.get(v, f'"{v}",') for v in values]
    new = f"{key} = []" if not items else f"{key} = [\n" + "".join(f"  {i}\n" for i in items) + "]"
    if m:
        body = body[:m.start()] + new + body[m.end():]
    else:
        body = body.rstrip("\n") + f"\n{new}\n\n"
    return text[:sec.start()] + body + text[sec.end():]


def set_toml_value(text, section, key, value):
    """Set `key = value` in [section] (re-using a `# key = ...` template line), or comment it out if value is None."""
    sec = re.search(rf"^\[{re.escape(section)}\]\n(?:(?!^\[).*\n?)*", text, re.M)
    if not sec:
        raise TvError(f"profile has no [{section}] section")
    body = sec.group(0)
    live = re.search(rf"^{key}\s*=\s*[^#\n]*?(\s+#.*)?$", body, re.M)
    template = re.search(rf"^#\s*{key}\s*=.*$", body, re.M)
    line = f"{key} = {json.dumps(value)}"
    if value is None:
        if live:
            body = body[:live.start()] + "# " + live.group(0) + body[live.end():]
    elif live:
        body = body[:live.start()] + line + (live.group(1) or "") + body[live.end():]
    elif template:
        body = body[:template.start()] + line + body[template.end():]
    else:
        body = body.rstrip("\n") + f"\n{line}\n\n"
    return text[:sec.start()] + body + text[sec.end():]


def set_home_settings(profile, values):
    """values: subset of launcher / screensaver / animation_scale; None removes the setting."""
    prof = load_profile(profile)
    catalog = load_catalog()
    text = prof["_path"].read_text()
    for key, value in values.items():
        if key == "launcher" and value not in (None, "stock") and not catalog.get(value, {}).get("home"):
            raise TvError(f"{value} is not a launcher in apps.toml")
        if key == "screensaver" and value is not None and not catalog.get(value, {}).get("dream"):
            raise TvError(f"{value} is not a screensaver in apps.toml")
        if key == "animation_scale" and value is not None:
            value = float(value)
            if not 0 <= value <= 2:
                raise TvError("animation_scale must be 0–2")
        if key not in ("launcher", "screensaver", "animation_scale"):
            raise TvError(f"unknown home setting {key}")
        text = set_toml_value(text, "home", key, value)
    tomllib.loads(text)
    prof["_path"].write_text(text)


def set_app_decision(profile, pkg, decision):
    """decision: auto | keep | disable | uninstall. Edits profiles/<tv>.toml."""
    prof = load_profile(profile)
    apps = prof["apps"]
    lists = {k: [p for p in apps.get(k, []) if p != pkg] for k in ("keep", "disable", "uninstall")}
    if decision in lists:
        lists[decision].append(pkg)
    elif decision != "auto":
        raise TvError(f"unknown decision {decision}")
    text = prof["_path"].read_text()
    for key, values in lists.items():
        if values != apps.get(key, []) or (key == "uninstall" and decision == "uninstall"):
            text = set_toml_array(text, "apps", key, values)
    tomllib.loads(text)  # never write a broken profile
    prof["_path"].write_text(text)


# ---- dashboard

class UiClient:
    """Best-effort event mirror from CLI runs to the dashboard."""
    def __init__(self):
        try:
            self.token = UI_TOKEN_FILE.read_text().strip()
        except OSError:
            self.token = None

    def send(self, event):
        if not self.token:
            return
        try:
            req = urllib.request.Request(f"http://127.0.0.1:{UI_PORT}/api/ingest", data=json.dumps(event).encode(),
                                         headers={"Content-Type": "application/json", "X-Token": self.token})
            urllib.request.urlopen(req, timeout=0.5).read()
        except Exception:
            self.token = None  # dashboard not running; stop trying


def ui_running():
    try:
        with socket.create_connection(("127.0.0.1", UI_PORT), timeout=0.3):
            return True
    except OSError:
        return False


def ensure_ui():
    """Start the dashboard in the background when a workflow starts (TVCTL_NO_UI=1 to skip)."""
    if os.environ.get("TVCTL_NO_UI") or ui_running():
        return
    log = open(STATE_DIR / "ui.log", "a")
    subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "ui", "--no-open"], stdout=log, stderr=log,
                     stdin=subprocess.DEVNULL, start_new_session=True, cwd=ROOT)
    for _ in range(30):
        if ui_running():
            break
        time.sleep(0.1)
    print(f"dashboard: http://127.0.0.1:{UI_PORT}", file=sys.stderr)
    if sys.stdout.isatty() and shutil.which("open"):
        subprocess.Popen(["open", f"http://127.0.0.1:{UI_PORT}"])


def ui_call(method, path, body=None, timeout=10):
    """Call the dashboard API as the agent. Raises TvError if it is not running."""
    try:
        token = UI_TOKEN_FILE.read_text().strip()
    except OSError:
        raise TvError("dashboard not running (start it: ./tvctl ui)")
    req = urllib.request.Request(f"http://127.0.0.1:{UI_PORT}{path}", method=method,
                                 data=json.dumps(body).encode() if body is not None else None,
                                 headers={"Content-Type": "application/json", "X-Token": token})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read())
    except urllib.error.HTTPError as e:
        try:
            msg = json.loads(e.read()).get("error")
        except Exception:
            msg = str(e)
        raise TvError(msg)
    except (urllib.error.URLError, OSError) as e:
        raise TvError(f"dashboard not reachable: {e}")


