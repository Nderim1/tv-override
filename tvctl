# ---------------------------------------------------------------- workflow engine

class Hooks:
    """How a Workflow talks to its driver (terminal, dashboard). Override what you need."""
    def emit(self, event): pass
    def confirm(self, actions):
        """Return the indexes of `actions` (all status=confirm) the owner approved."""
        return set()
    def wait(self, waiting):
        """Owner has to act on the TV. Return True to re-check, False to stop."""
        return False
    def stopped(self):
        return False


class Workflow:
    """One run: connect → measure → plan → apply rounds (pausing for the owner) → reboot → measure → save.

    mode: "apply" | "plan" | "verify" (reboot + measure) | "restore" (back to the TV's defaults)
    """
    def __init__(self, profile, mode="apply", hooks=None, yes=False, reboot=False, measure=True, source="cli",
                 revert_run=None, keep_reverted=False):
        self.profile_name, self.mode, self.hooks = profile, mode, hooks or Hooks()
        self.revert_run, self.keep_reverted = revert_run, keep_reverted
        self.yes, self.reboot, self.measure, self.source = yes, reboot, measure, source
        self.ctx = None
        self.record = {"id": datetime.now().strftime("%Y%m%d-%H%M%S"), "tv": None, "mode": mode, "source": source,
                       "started": now_iso(), "finished": None, "outcome": "running", "phases": [],
                       "perf_before": None, "perf_after": None, "rounds": [], "summary": {}, "status": None}

    def emit(self, type_, **data):
        self.hooks.emit({"type": type_, "tv": self.record["tv"], "run": self.record["id"], "time": now_iso(), **data})

    def phase(self, name, fn):
        entry = {"name": name, "status": "running", "started": now_iso()}
        self.record["phases"].append(entry)
        self.emit("phase", name=name, status="running")
        try:
            result = fn()
            entry.update(status="done", finished=now_iso())
            self.emit("phase", name=name, status="done")
            return result
        except Exception as e:
            entry.update(status="error", finished=now_iso(), detail=str(e))
            self.emit("phase", name=name, status="error", detail=str(e))
            raise

    def run(self):
        prof = load_profile(self.profile_name)
        self.record["tv"] = prof["tv"]["name"]
        self.emit("run", status="running", mode=self.mode, source=self.source)
        try:
            self.phase("connect", lambda: self._connect(prof))
            if self.measure:
                self.record["perf_before"] = self.phase("measure-before", self._measure)
                self.emit("perf", which="before", data=self.record["perf_before"])
            if self.mode == "plan":
                acts = self.phase("plan", lambda: make_plan(self.ctx))
                self._round(acts, execute=False)
                self.record["outcome"] = "ok"
            elif self.mode == "apply":
                self.phase("apply", self._apply)
            elif self.mode == "restore":
                self.phase("restore", self._restore)
            elif self.mode == "revert":
                self.phase("revert", self._revert)
            if self.mode != "plan" and self.record["outcome"] in ("ok", "running") and \
                    (self.mode == "verify" or (self.reboot and self.record["summary"].get("changed"))):
                self.phase("reboot", self.ctx.dev.reboot_and_wait)
                self.ctx.refresh()
            if self.measure and self.mode != "plan":
                self.record["perf_after"] = self.phase("measure-after", self._measure)
                self.emit("perf", which="after", data=self.record["perf_after"])
            self.record["status"] = self.phase("verify", lambda: status_data(self.ctx))
            if self.record["outcome"] == "running":
                self.record["outcome"] = "ok"
        except StopRun:
            self.record["outcome"] = "stopped"
        except Exception as e:  # report every failure to the driver, then re-raise for the CLI
            self.record["outcome"] = "error"
            self.record["error"] = str(e)
            self.emit("log", level="error", msg=str(e))
        finally:
            self.record["finished"] = now_iso()
            if self.record["tv"] and self.mode != "plan":
                save_run(self.record)
            self.emit("run", status=self.record["outcome"], record=self.summary())
        return self.record

    def summary(self):
        r = self.record
        pb, pa = r["perf_before"] or {}, r["perf_after"] or {}
        return {"id": r["id"], "tv": r["tv"], "mode": r["mode"], "source": r["source"], "outcome": r["outcome"],
                "started": r["started"], "finished": r["finished"], "summary": r["summary"],
                "mem_before": pb.get("mem_available_mb"), "mem_after": pa.get("mem_available_mb"),
                "error": r.get("error")}

    # -- phases

    def _connect(self, prof):
        dev = Device(prof["tv"]["host"], prof["tv"].get("port", 5555))
        dev.connect(wait=30)
        self.ctx = Ctx(prof, dev)
        check_identity(self.ctx)

    def _measure(self):
        return perf(self.ctx.dev, self.ctx.pkgs)

    def _check_stop(self):
        if self.hooks.stopped():
            raise StopRun()

    def _round(self, acts, execute=True):
        n = len(self.record["rounds"])
        for i, a in enumerate(acts):
            a["index"] = i
        self.record["rounds"].append(acts)
        self.emit("round", n=n, actions=public(acts), execute=execute)
        if not execute:
            return
        confirms = [a for a in acts if a["status"] == "confirm"]
        if confirms:
            approved = set(range(len(confirms))) if self.yes else self.hooks.confirm(public(confirms))
            for j, a in enumerate(confirms):
                a["status"] = "todo" if j in approved else "declined"
                self.emit("action", n=n, **public([a])[0])
        for a in acts:
            self._check_stop()
            if a["status"] not in ("todo", "manual") or not a["fn"]:
                continue
            if a["status"] == "todo":
                a["status"] = "running"
                self.emit("action", n=n, **public([a])[0])
            try:
                a["fn"]()
                if a["status"] == "running":
                    a["status"] = "done"
            except TvError as e:
                a["status"], a["detail"] = "error", str(e)
            self.emit("action", n=n, **public([a])[0])
        log_history(self.ctx.prof, acts)

    def _apply(self):
        changed = 0
        while True:
            self._check_stop()
            acts = make_plan(self.ctx)
            self._round(acts)
            changed += sum(1 for a in acts if a["status"] == "done")
            waiting = [a for a in acts if a["status"] in ("manual", "blocked")]
            self.ctx.refresh()
            if len(self.record["rounds"]) >= 8:
                break
            if any(a["status"] == "done" for a in acts) and not waiting:
                continue  # e.g. an install unblocked a later step
            if waiting:
                self.emit("waiting", items=public(waiting))
                if self.hooks.wait(public(waiting)):
                    self.ctx.refresh()
                    continue
            break
        final = self.record["rounds"][-1]
        count = lambda *st: sum(1 for r in self.record["rounds"] for a in r if a["status"] in st)
        self.record["summary"] = {
            "changed": changed,
            "disabled": sum(1 for r in self.record["rounds"] for a in r if a["status"] == "done" and a["action"] == "disable"),
            "uninstalled": sum(1 for r in self.record["rounds"] for a in r if a["status"] == "done" and a["action"] == "uninstall"),
            "installed": sum(1 for r in self.record["rounds"] for a in r if a["status"] == "done" and a["action"] == "install"),
            "errors": count("error"),
            "waiting": [public([a])[0] for a in final if a["status"] in ("manual", "blocked", "declined")],
        }
        if any(a["status"] == "error" for a in final):
            self.record["outcome"] = "error"
        elif any(a["status"] in ("manual", "blocked") for a in final):
            self.record["outcome"] = "waiting"
        else:
            self.record["outcome"] = "ok"

    def _revert(self):
        source = load_run(self.record["tv"], self.revert_run)
        self.record["reverts"] = self.revert_run
        acts = revert_plan(self.ctx, source)
        self._round(acts)
        kept = []
        if self.keep_reverted:  # so the next apply does not disable them again
            for a in acts:
                if a["status"] == "done" and a["action"] == "enable":
                    set_app_decision(self.record["tv"], a["target"], "keep")
                    kept.append(a["target"])
        self.record["summary"] = {
            "changed": sum(1 for a in acts if a["status"] == "done"),
            "errors": sum(1 for a in acts if a["status"] == "error"),
            "reinstall": [a["target"] for a in acts if a["action"] == "reinstall"],
            "kept": kept, "reverts": self.revert_run}
        self.record["outcome"] = "error" if self.record["summary"]["errors"] else "ok"

    def _restore(self):
        acts = restore_defaults_plan(self.ctx)
        self._round(acts)
        self.record["summary"] = {"changed": sum(1 for a in acts if a["status"] == "done"),
                                  "errors": sum(1 for a in acts if a["status"] == "error"),
                                  "reinstall": restore_gone(self.ctx)}
        self.record["outcome"] = "error" if self.record["summary"]["errors"] else "ok"


class StopRun(Exception):
    pass


def restore_defaults_plan(ctx):
    """Back to the TV's own defaults: every package on, stock home, baseline screensaver/animations."""
    acts = []
    for pkg in sorted(p for p, i in ctx.pkgs.items() if not i["enabled"]):
        acts.append(action("restore", pkg, "enable", ctx.classifier.classify(pkg)[1],
                           fn=lambda p=pkg: pm(ctx, "enable", p), undo={"op": "disable", "pkg": pkg}))
    stock, stock_home = stock_launcher(ctx.presets)
    if stock_home and ctx.dev.home() != stock_home:
        acts.append(action("restore", stock_home, "set-home", "stock home",
                           fn=lambda: ctx.dev.sh(f"cmd package set-home-activity --user 0 {stock_home}"),
                           undo={"op": "home", "value": ctx.dev.home()}))
    baseline = state_dir(ctx.prof) / "baseline.json"
    settings = json.loads(baseline.read_text()).get("settings", {}) if baseline.exists() else {}
    defaults = {"screensaver_components": settings.get("screensaver_components"),
                **{k: settings.get(k) or "1.0" for k in ANIMATION_KEYS}}
    current = ctx.dev.tv_settings()
    for key, value in defaults.items():
        if value and current.get(key) != value:
            ns = "secure" if key.startswith("screensaver") else "global"
            acts.append(action("restore", key, "set", value,
                               fn=lambda ns=ns, k=key, v=value: ctx.dev.sh(f"settings put {ns} {k} {shlex.quote(v)}"),
                               undo={"op": "settings", "ns": ns, "values": {key: current.get(key)}}))
    return acts


def legacy_undo(ctx, a):
    """Best-effort inverse for actions recorded before runs stored their own undo."""
    stock, stock_home = stock_launcher(ctx.presets)
    what, target = a["action"], a["target"]
    if what == "disable":
        return {"op": "enable", "pkg": target}
    if what == "enable":
        return {"op": "disable", "pkg": target}
    if what == "uninstall":
        return {"op": "reinstall", "pkg": target}
    if what == "install":
        return {"op": "uninstall", "pkg": target}
    if what == "replace-stock":
        return {"op": "launcher", "enable": stock, "home": stock_home}
    if what == "allow":
        return {"op": "appop", "pkg": target, "name": ctx.quirks.get("autostart_appop", "APP_AUTO_START"),
                "value": "default"}
    return None  # settings/keymap: previous values were not recorded


def revert_plan(ctx, record):
    """Actions that undo everything a run changed, newest first. Uninstalled apps come back as manual steps."""
    acts, seen = [], set()
    done = [a for r in record.get("rounds", []) for a in r if a.get("status") == "done"]
    live, _ = live_tv(ctx.presets)
    for a in reversed(done):
        u = a.get("undo") or legacy_undo(ctx, a)
        if not u:
            acts.append(action("revert", a["target"], a["action"], "previous value was not recorded", status="skipped"))
            continue
        key = (u["op"], u.get("pkg") or u.get("ns") or a["target"])
        if key in seen:
            continue
        seen.add(key)
        op, pkg = u["op"], u.get("pkg")
        if op == "enable" and ctx.installed(pkg) and not ctx.enabled(pkg):
            acts.append(action("revert", pkg, "enable", f"undo: {a['action']} ({a['detail']})"[:200],
                               fn=lambda p=pkg: pm(ctx, "enable", p)))
        elif op == "disable" and ctx.installed(pkg) and ctx.enabled(pkg) and pkg not in live:
            acts.append(action("revert", pkg, "disable", f"undo: {a['action']}", fn=lambda p=pkg: pm(ctx, "disable", p)))
        elif op == "uninstall" and ctx.installed(pkg):
            acts.append(action("revert", pkg, "uninstall", f"undo: installed by that run", status="confirm",
                               fn=uninstall_fn(ctx, pkg)))
        elif op == "reinstall" and not ctx.installed(pkg):
            acts.append(action("revert", pkg, "reinstall", "uninstalled by that run: reinstall it from the Play Store",
                               status="manual"))
        elif op == "appop":
            acts.append(action("revert", pkg, "appop", f"{u['name']} → {u['value']}",
                               fn=lambda p=pkg, n=u["name"], v=u["value"]: ctx.dev.sh(f"appops set {p} {n} {v}")))
        elif op == "keymap":
            app = keymap_app(ctx)
            if app and ctx.installed(app["package"]):
                acts.append(action("revert", app["package"], "push", f"previous key map: {u['value'] or '(empty)'}",
                                   fn=lambda v=u["value"] or "": push_keymap(ctx, v)))
        elif op == "launcher":
            def fn(u=u):
                for p in u.get("enable", []):
                    if ctx.installed(p) and not ctx.enabled(p):
                        pm(ctx, "enable", p)
                if u.get("home"):
                    ctx.dev.sh(f"cmd package set-home-activity --user 0 {u['home']}")
            acts.append(action("revert", u.get("home") or "home", "restore-home",
                               f"re-enable {', '.join(u.get('enable', []))}; home → {u.get('home')}", fn=fn))
        elif op == "home" and u.get("value"):
            acts.append(action("revert", u["value"], "set-home", "previous home",
                               fn=lambda v=u["value"]: ctx.dev.sh(f"cmd package set-home-activity --user 0 {v}")))
        elif op == "settings":
            def fn(u=u):
                for k, v in u["values"].items():
                    ctx.dev.sh(f"settings delete {u['ns']} {k}" if v is None else
                               f"settings put {u['ns']} {k} {shlex.quote(str(v))}")
            acts.append(action("revert", u["ns"], "settings", ", ".join(f"{k}={v}" for k, v in u["values"].items()),
                               fn=fn))
    return acts


def load_run(name, run_id):
    if not re.fullmatch(r"\d{8}-\d{6}", run_id):
        raise TvError("bad run id")
    path = STATE_DIR / name / "runs" / f"{run_id}.json"
    if not path.exists():
        raise TvError(f"no run {run_id} for {name}")
    return json.loads(path.read_text())


def restore_gone(ctx):
    baseline = state_dir(ctx.prof) / "baseline.json"
    if not baseline.exists():
        return []
    before = json.loads(baseline.read_text())["packages"]
    return sorted(p for p, i in before.items() if i["user"] and p not in ctx.pkgs)


class CliHooks(Hooks):
    """Terminal driver: prints progress, asks on the TTY, mirrors events to the dashboard if it runs."""
    def __init__(self, args):
        self.args = args
        self.interactive = sys.stdin.isatty() and not args.json
        self.ui = UiClient()

    def emit(self, event):
        self.ui.send(event)
        if self.args.json:
            return
        t = event["type"]
        if t == "phase" and event["status"] != "done":
            print(f"» {event['name']} {event['status']}" + (f": {event.get('detail')}" if event.get("detail") else ""))
        elif t == "round" and not event["execute"]:
            print_actions(event["actions"])
        elif t == "action" and event["status"] not in ("running",):
            print_actions([event])
        elif t == "perf":
            d = event["data"]
            print(f"  RAM available {d['mem_available_mb']} MB of {d['mem_total_mb']} MB, "
                  f"swap used {d['swap_used_mb']} MB, load {d['load1']}")

    def confirm(self, actions):
        if not self.interactive:
            return set()
        return {i for i, a in enumerate(actions) if confirm(f"  {a['action']} {a['target']} – {a['detail']}?")}

    def wait(self, waiting):
        if not self.interactive or getattr(self.args, "no_wait", False):
            return False
        print("\nOn the TV:")
        for a in waiting:
            print(f"  • {a['detail']}")
        input("Press Enter when done to re-check (Ctrl-C to stop)… ")
        return True


def cmd_apply(args):
    ensure_ui()
    wf = Workflow(args.profile, "apply", CliHooks(args), yes=args.yes, reboot=args.reboot,
                  measure=args.measure, source="cli")
    rec = wf.run()
    if rec["outcome"] == "error" and rec.get("error"):
        raise TvError(rec["error"])
    final = rec["rounds"][-1] if rec["rounds"] else []
    errors = [a for a in final if a["status"] == "error"]
    waiting = [a for a in final if a["status"] in ("manual", "blocked", "declined")]
    if args.json:
        print(json.dumps({"tv": rec["tv"], "run": rec["id"], "outcome": rec["outcome"],
                          "rounds": [public(r) for r in rec["rounds"]], "waiting_on_owner": public(waiting),
                          "errors": public(errors), "perf_before": rec["perf_before"], "perf_after": rec["perf_after"]},
                         indent=1))
    elif rec["outcome"] == "ok":
        print("✓ TV matches the profile")
